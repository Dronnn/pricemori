    },
    "Over time you build your own history: dates, stores, and honest comparisons." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit der Zeit entsteht deine eigene Historie: Daten, Läden und ehrliche Vergleiche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el tiempo construyes tu propio historial: fechas, tiendas y comparaciones honestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au fil du temps, vous construisez votre propre historique : dates, magasins et comparaisons honnêtes."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ժամանակի ընթացքում կառուցում եք ձեր սեփական պատմությունը՝ ամսաթվեր, խանութներ և ազնիվ համեմատություններ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seiring waktu Anda membangun riwayat sendiri: tanggal, toko, dan perbandingan yang jujur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nel tempo costruisci il tuo storico: date, negozi e confronti onesti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間がたつと、日付・お店・正直な比較があなたの履歴になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시간이 지나면 날짜, 매장, 정직한 비교가 담긴 나만의 기록이 쌓입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na verloop van tijd bouw je je eigen geschiedenis op: datums, winkels en eerlijke vergelijkingen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z czasem budujesz własną historię: daty, sklepy i uczciwe porównania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o tempo você constrói seu próprio histórico: datas, lojas e comparações honestas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Со временем у вас появится собственная история: даты, магазины и честные сравнения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamanla kendi geçmişinizi oluşturursunuz: tarihler, mağazalar ve dürüst karşılaştırmalar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "З часом ви будуєте власну історію: дати, магазини й чесні порівняння."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo thời gian, bạn xây dựng lịch sử của riêng mình: ngày tháng, cửa hàng và so sánh trung thực."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "随着时间推移，你会积累自己的历史：日期、门店和诚实的比较。"
          }
        }
      }
    },
