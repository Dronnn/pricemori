    "Record a price at any store. You can add a shelf price without buying the product.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einen Preis in einem beliebigen Geschäft. Du kannst einen Regalpreis hinzufügen, ohne das Produkt zu kaufen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un prix dans n’importe quel magasin. Vous pouvez ajouter un prix en rayon sans acheter le produit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un precio en cualquier tienda. Puedes añadir un precio de estantería sin comprar el producto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre um preço em qualquer loja. Você pode adicionar um preço de prateleira sem comprar o produto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj cenę w dowolnym sklepie. Możesz dodać cenę z półki bez kupowania produktu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте цену в любом магазине. Можно добавить цену на полке, не покупая товар."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте ціну в будь-якому магазині. Можна додати ціну на полиці, не купуючи товар."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցեք գին ցանկացած խանութում։ Կարող եք ավելացնել դարակի գին՝ առանց ապրանքը գնելու։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの店舗でも価格を記録できます。商品を買わなくても棚価格を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 매장에서든 가격을 기록할 수 있습니다. 제품을 사지 않아도 진열 가격을 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可在任意门店记录价格。即使不购买商品，也可以添加货架价格。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi giá tại bất kỳ cửa hàng nào. Bạn có thể thêm giá kệ mà không cần mua sản phẩm."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un prezzo in qualsiasi negozio. Puoi aggiungere un prezzo a scaffale senza acquistare il prodotto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer een prijs bij elke winkel. Je kunt een schapprijs toevoegen zonder het product te kopen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir mağazada fiyat kaydet. Ürünü satın almadan raf fiyatı ekleyebilirsin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat harga di toko mana pun. Kamu dapat menambahkan harga rak tanpa membeli produknya."
          }
        }
      }
    },
