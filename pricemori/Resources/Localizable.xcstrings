    "Keep editing to finish your entry, or discard this draft.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeite weiter, um deinen Eintrag fertigzustellen, oder verwerfe diesen Entwurf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuez la modification pour terminer votre saisie, ou abandonnez ce brouillon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigue editando para terminar tu entrada o descarta este borrador."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue editando para concluir seu registro ou descarte este rascunho."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontynuuj edycję, aby dokończyć wpis, lub odrzuć ten szkic."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжите редактирование, чтобы завершить запись, или отмените черновик."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжте редагування, щоб завершити запис, або відхиліть цю чернетку."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Շարունակեք խմբագրել՝ գրառումն ավարտելու համար, կամ մերժեք այս սևագիրը։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集を続けて入力を完了するか、この下書きを破棄してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속 편집해 입력을 마치거나 이 초안을 버리세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "继续编辑以完成输入，或丢弃此草稿。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiếp tục sửa để hoàn tất mục nhập, hoặc bỏ bản nháp này."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a modificare per completare l’inserimento oppure scarta questa bozza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blijf wijzigen om je invoer af te maken, of verwerp dit concept."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girişini tamamlamak için düzenlemeye devam et veya bu taslağı at."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lanjutkan mengedit untuk menyelesaikan entri, atau buang draf ini."
          }
        }
      }
    },
    "Keep the exported file safe. The app cannot check whether you move or delete it later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre die exportierte Datei sicher auf. Die App kann nicht prüfen, ob du sie später verschiebst oder löschst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez le fichier exporté en lieu sûr. L’app ne peut pas vérifier si vous le déplacez ou le supprimez plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda el archivo exportado en un lugar seguro. La app no puede comprobar si lo mueves o eliminas después."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o arquivo exportado em local seguro. O app não pode verificar se você o mover ou excluir depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadbaj o wyeksportowany plik. Aplikacja nie może sprawdzić, czy później go przeniesiesz lub usuniesz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните экспортированный файл. Приложение не может проверить, переместите вы его позже или удалите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережіть експортований файл. Застосунок не може перевірити, чи ви його пізніше перемістите або видалите."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահեք արտահանված ֆայլը ապահով։ Հավելվածը չի կարող ստուգել՝ արդյոք այն հետագայում տեղափոխում կամ ջնջում եք։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出したファイルは大切に保管してください。後で移動や削除をしてもアプリからは確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 파일을 안전하게 보관하세요. 나중에 파일을 이동하거나 삭제해도 앱에서 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请妥善保管导出的文件。应用无法检测你之后是否移动或删除它。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ tệp đã xuất an toàn. Ứng dụng không thể kiểm tra nếu sau này bạn di chuyển hay xóa tệp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il file esportato in un posto sicuro. L’app non può sapere se in seguito lo sposterai o eliminerai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar het geëxporteerde bestand veilig. De app kan niet controleren of je het later verplaatst of verwijdert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dışa aktarılan dosyayı güvende tut. Uygulama, dosyayı daha sonra taşıyıp taşımadığını veya silip silmediğini kontrol edemez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan file yang diekspor dengan aman. App tidak dapat memeriksa apakah kamu memindahkan atau menghapusnya nanti."
          }
        }
      }
    },
