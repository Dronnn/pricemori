    "Correct a mistake in this saved record. For a newly observed price, create a new observation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Korrigiere einen Fehler in diesem gespeicherten Eintrag. Für einen neu beobachteten Preis erstelle eine neue Beobachtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigez une erreur dans cet enregistrement. Pour un prix nouvellement observé, créez une nouvelle observation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrige un error en este registro guardado. Para un precio recién observado, crea una nueva observación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrija um erro neste registro salvo. Para um preço recém-observado, crie uma nova observação."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popraw błąd w tym zapisanym wpisie. Dla nowo zaobserwowanej ceny utwórz nową obserwację."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исправьте ошибку в этой сохранённой записи. Для только что замеченной цены создайте новое наблюдение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виправте помилку в цьому збереженому записі. Для щойно поміченої ціни створіть нове спостереження."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ուղղեք սխալը այս պահված գրառումում։ Նոր նկատված գնի համար ստեղծեք նոր դիտարկում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの記録の誤りを修正します。新しく観測した価格は、新しい観測記録として追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 기록의 오류를 수정합니다. 새로 관측한 가격은 새 관측 기록으로 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更正此已保存记录中的错误。新观察到的价格请新建记录。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sửa lỗi trong bản ghi đã lưu. Với giá vừa quan sát, hãy tạo lần ghi mới."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Correggi un errore in questo record salvato. Per un prezzo appena rilevato, crea una nuova rilevazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrigeer een fout in dit bewaarde record. Maak voor een nieuw waargenomen prijs een nieuwe observatie."
          }
        },
