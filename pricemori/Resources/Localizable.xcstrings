            "value": "Una observación tiene un tamaño de paquete ilegible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma observação tem um tamanho de pacote ilegível."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwacja ma rozmiar opakowania, którego nie można odczytać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В наблюдении указан размер упаковки, который не удаётся прочитать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У спостереженні вказано розмір упаковки, який не вдається прочитати."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Դիտարկումն ունի փաթեթի չափ, որը հնարավոր չէ կարդալ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "観測記録のパッケージ容量を読み取れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관측 기록의 패키지 용량을 읽을 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一条记录的包装规格无法读取。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần ghi có dung tích gói không đọc được."
          }
        },
        "it": {
