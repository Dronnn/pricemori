    "This branch will leave active store pickers. Its earlier observations and charts will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Filiale verschwindet aus den aktiven Geschäftsauswahlen. Ihre früheren Beobachtungen und Diagramme bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette succursale quittera les sélecteurs de magasins actifs. Ses observations précédentes et ses graphiques seront conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sucursal dejará los selectores de tiendas activos. Sus observaciones anteriores y sus gráficos se conservarán."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta filial sairá dos seletores de lojas ativos. Suas observações anteriores e seus gráficos serão mantidos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten oddział zniknie z wyboru aktywnych sklepów. Jego wcześniejsze obserwacje i wykresy zostaną zachowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот филиал исчезнет из выбора активных магазинов. Его прежние наблюдения и графики сохранятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відділення зникне з вибору активних магазинів. Його попередні спостереження та графіки збережуться."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս մասնաճյուղը կհեռանա ակտիվ խանութների ընտրությունից։ Դրա նախորդ դիտարկումները և գրաֆիկները կպահվեն։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この店舗は有効な店舗の選択肢から外れます。以前の観測記録とグラフは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지점은 활성 매장 선택 목록에서 빠집니다. 이전 관측 기록과 차트는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此门店将从使用中的门店选择器中移除。其之前的记录和图表会保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi nhánh này sẽ rời danh sách chọn cửa hàng đang dùng. Các lần ghi và biểu đồ trước đó vẫn được giữ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa filiale uscirà dai selettori dei negozi attivi. Le rilevazioni precedenti e i grafici verranno mantenuti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze vestiging verdwijnt uit de kiezers voor actieve winkels. Eerdere observaties en grafieken blijven bewaard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şube etkin mağaza seçicilerinden çıkacak. Önceki gözlemleri ve grafikleri korunacak."
