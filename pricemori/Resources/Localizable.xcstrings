        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր օրագիրը պահվում է այս iPhone-ում։ Պահեք ամբողջական պատճեն մի վայրում, որը հետագայում հասանելի կլինի ձեզ։"
