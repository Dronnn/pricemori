        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký của bạn vẫn an toàn trên thiết bị này. Không có lần ghi nào bị xóa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Diario è al sicuro su questo dispositivo. Nessuna rilevazione è stata rimossa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je dagboek is veilig op dit apparaat. Er zijn geen observaties verwijderd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğün bu cihazda güvende. Hiçbir gözlem kaldırılmadı."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnalmu aman di perangkat ini. Tidak ada observasi yang dihapus."
          }
        }
      }
    },
    "Your journal is stored on this iPhone. Keep a full backup somewhere you can access later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Journal liegt auf diesem iPhone. Bewahre ein vollständiges Backup an einem später zugänglichen Ort auf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal est stocké sur cet iPhone. Conservez une sauvegarde complète dans un endroit accessible plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu diario se guarda en este iPhone. Guarda una copia completa en un lugar al que puedas acceder después."
