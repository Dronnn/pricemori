            "value": "Недостаточно сопоставимых наблюдений в этом филиале за выбранный период."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостатньо порівнюваних спостережень у цьому відділенні за вибраний період."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բավարար համեմատելի դիտարկումներ չկան այս մասնաճյուղում ընտրված ժամանակահատվածում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した期間に、この店舗で比較可能な観測記録が足りません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 기간에 이 지점의 비교 가능한 관측 기록이 충분하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选时间段内，此门店的可比记录不足。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đủ lần ghi so sánh được tại chi nhánh này trong khoảng đã chọn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevazioni confrontabili insufficienti in questa filiale nel periodo selezionato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg vergelijkbare observaties in deze vestiging in de geselecteerde periode."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dönemde bu şubede yeterli karşılaştırılabilir gözlem yok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Observasi yang dapat dibandingkan di cabang ini tidak cukup dalam periode yang dipilih."
          }
        }
      }
    },
