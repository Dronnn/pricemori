        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona sin conexión. Tu diario se queda en este dispositivo. No necesitas cuenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona offline. Seu diário fica neste dispositivo. Não é preciso conta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działa offline. Twój dziennik pozostaje na tym urządzeniu. Konto nie jest potrzebne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работает офлайн. Журнал остаётся на этом устройстве. Аккаунт не нужен."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Працює офлайн. Журнал залишається на цьому пристрої. Обліковий запис не потрібен."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Աշխատում է անցանց։ Ձեր օրագիրը մնում է այս սարքում։ Հաշիվ պետք չէ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフラインで動作します。ジャーナルはこのデバイスに保存されます。アカウントは不要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인으로 작동합니다. 저널은 이 기기에 저장됩니다. 계정이 필요 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可离线使用。你的记录保存在此设备上。无需账户。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoạt động ngoại tuyến. Nhật ký ở lại trên thiết bị này. Không cần tài khoản."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona offline. Il tuo Diario resta su questo dispositivo. Non serve un account."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt offline. Je dagboek blijft op dit apparaat. Je hebt geen account nodig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı çalışır. Günlüğün bu cihazda kalır. Hesap gerekmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berfungsi offline. Jurnalmu tetap di perangkat ini. Tidak perlu akun."
          }
        }
      }
    },
