          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rilevazioni datate, unità e condizioni\nNon ripristina un Diario completo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日付付きの観測記録、単位、条件\n完全なジャーナルは復元しません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "날짜가 있는 관측 기록, 단위 및 조건\n완전한 저널은 복원하지 않습니다"
