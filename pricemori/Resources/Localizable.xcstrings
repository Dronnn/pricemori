    "Your saved history is kept. You will return to the product." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein gespeicherter Verlauf bleibt erhalten. Du kehrst zum Produkt zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu historial guardado se conserva. Volverás al producto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre historique enregistré est conservé. Vous reviendrez au produit."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր պահված պատմությունը պահվում է։ Դուք կվերադառնաք ապրանքին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riwayat tersimpanmu tetap disimpan. Kamu akan kembali ke produk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cronologia salvata viene mantenuta. Tornerai al prodotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された履歴は保持されます。商品に戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 기록은 유지됩니다. 제품으로 돌아갑니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bewaarde geschiedenis blijft behouden. Je keert terug naar het product."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja zapisana historia jest zachowana. Wrócisz do produktu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu histórico salvo é mantido. Você voltará ao produto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша сохранённая история сохранена. Вы вернётесь к товару."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı geçmişin korunur. Ürüne geri döneceksin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша збережена історія збережена. Ви повернетеся до товару."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lịch sử đã lưu được giữ. Bạn sẽ trở về sản phẩm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你保存的历史记录会保留。你将返回该商品。"
          }
        }
      }
    },
    "Your saved stores will be available at the next step. Package size is recorded with the price." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gespeicherten Geschäfte sind im nächsten Schritt verfügbar. Die Packungsgröße wird mit dem Preis gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tiendas guardadas estarán disponibles en el siguiente paso. El tamaño del paquete se guarda con el precio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos magasins enregistrés seront disponibles à l’étape suivante. La taille du paquet est enregistrée avec le prix."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր պահված խանութները հասանելի կլինեն հաջորդ քայլում։ Փաթեթի չափը գրանցվում է գնի հետ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toko yang kamu simpan akan tersedia di langkah berikutnya. Ukuran kemasan dicatat bersama harga."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I negozi salvati saranno disponibili al passaggio successivo. Il formato della confezione viene registrato con il prezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した店舗は次のステップで使用できます。パッケージの容量は価格と一緒に記録されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장한 매장은 다음 단계에서 사용할 수 있습니다. 패키지 용량은 가격과 함께 기록됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bewaarde winkels zijn beschikbaar in de volgende stap. De verpakkingsgrootte wordt bij de prijs opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisane sklepy będą dostępne w następnym kroku. Rozmiar opakowania jest zapisywany razem z ceną."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas lojas salvas estarão disponíveis na próxima etapa. O tamanho do pacote é salvo com o preço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённые магазины будут доступны на следующем шаге. Размер упаковки записывается вместе с ценой."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı mağazaların sonraki adımda kullanılabilir olacak. Paket boyutu fiyatla birlikte kaydedilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережені магазини будуть доступні на наступному кроці. Розмір упаковки записується разом з ціною."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cửa hàng đã lưu sẽ có ở bước tiếp theo. Dung tích gói được ghi cùng giá."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的门店将在下一步可用。包装规格会与价格一起记录。"
          }
        }
      }
    },
    "Your stored journal has not been deleted. Free some storage and restart the app, or try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein gespeichertes Journal wurde nicht gelöscht. Gib Speicherplatz frei und starte die App neu oder versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu diario guardado no se ha eliminado. Libera espacio y reinicia la app, o inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre journal enregistré n’a pas été supprimé. Libérez de l’espace et redémarrez l’app, ou réessayez."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր պահպանված մատյանը չի ջնջվել։ Ազատեք հիշողության տարածք և վերագործարկեք հավելվածը կամ կրկին փորձեք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jurnal yang tersimpan belum dihapus. Kosongkan ruang penyimpanan lalu mulai ulang aplikasi, atau coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il diario salvato non è stato eliminato. Libera spazio e riavvia l’app, oppure riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存済みの記録帳は削除されていません。空き容量を増やしてアプリを再起動するか、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장된 일지는 삭제되지 않았습니다. 저장 공간을 확보하고 앱을 다시 시작하거나 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je opgeslagen dagboek is niet verwijderd. Maak opslagruimte vrij en start de app opnieuw, of probeer het nogmaals."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisany dziennik nie został usunięty. Zwolnij miejsce i uruchom aplikację ponownie lub spróbuj jeszcze raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu diário salvo não foi apagado. Libere espaço e reinicie o app ou tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохранённый журнал не удалён. Освободите место и перезапустите приложение или попробуйте ещё раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıtlı günlüğünüz silinmedi. Depolama alanı açıp uygulamayı yeniden başlatın veya tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережений журнал не видалено. Звільніть місце й перезапустіть застосунок або спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhật ký đã lưu chưa bị xóa. Hãy giải phóng dung lượng rồi khởi động lại ứng dụng, hoặc thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的日志未被删除。请释放存储空间并重新启动应用，或重试。"
          }
        }
      }
    },
    "Your support helps keep Pricemori independent. Nothing is unlocked, and your journal stays exactly as it is." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Unterstützung hilft, Pricemori unabhängig zu halten. Es wird nichts freigeschaltet, und dein Journal bleibt genau wie es ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apoyo ayuda a que Pricemori siga siendo independiente. No se desbloquea nada y tu diario queda tal cual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre soutien aide Pricemori à rester indépendant. Rien n’est débloqué et votre journal reste exactement tel quel."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ձեր աջակցությունն օգնում է Pricemori-ին մնալ անկախ։ Ոչինչ չի բացվում, և օրագիրը մնում է ճիշտ այնպիսին, ինչպիսին կա։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dukunganmu membantu Pricemori tetap independen. Tidak ada yang terbuka, dan jurnalmu tetap persis seperti semula."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo sostegno aiuta Pricemori a restare indipendente. Nulla viene sbloccato e il tuo Diario resta esattamente com’è."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの支援がPricemoriの独立を支えます。機能は解除されず、ジャーナルはそのまま変わりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러분의 후원은 Pricemori의 독립을 지킵니다. 잠금 해제되는 것은 없으며 저널은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je steun helpt Pricemori onafhankelijk te houden. Er wordt niets ontgrendeld en je dagboek blijft precies zoals het is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje wsparcie pomaga utrzymać niezależność Pricemori. Nic nie zostaje odblokowane, a dziennik pozostaje bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu apoio ajuda a manter o Pricemori independente. Nada é desbloqueado e seu diário fica exatamente como está."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша поддержка помогает Pricemori оставаться независимым. Ничего не открывается, а журнал остаётся точно таким же."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desteğin Pricemori'nin bağımsız kalmasına yardımcı olur. Hiçbir şeyin kilidi açılmaz ve günlüğün olduğu gibi kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша підтримка допомагає Pricemori залишатися незалежним. Нічого не відкривається, а журнал залишається точно таким самим."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sự ủng hộ của bạn giúp Pricemori độc lập. Không có gì được mở khóa và nhật ký của bạn vẫn giữ nguyên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的支持帮助 Pricemori 保持独立。不会解锁任何内容，你的记录也保持不变。"
          }
        }
      }
    },
    "Your usual stores and individual branches" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
