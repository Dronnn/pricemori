    "An observation has a package size that cannot be read.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Beobachtung hat eine nicht lesbare Packungsgröße."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une observation a une taille de paquet illisible."
          }
        },
        "es": {
          "stringUnit": {
