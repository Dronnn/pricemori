    "It will be removed from history and charts. You can undo this from History.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag wird aus Verlauf und Diagrammen entfernt. Du kannst das im Verlauf rückgängig machen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sera retiré de l’historique et des graphiques. Vous pouvez annuler depuis l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se quitará del historial y de los gráficos. Puedes deshacerlo desde el historial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele será removido do histórico e dos gráficos. Você pode desfazer isso no histórico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięta z historii i wykresów. Możesz to cofnąć w Historii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оно исчезнет из истории и графиков. Это можно отменить в разделе «История»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Воно зникне з історії та графіків. Це можна скасувати в розділі «Історія»."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն կհեռացվի պատմությունից և գրաֆիկներից։ Կարող եք չեղարկել «Պատմություն»-ում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴とグラフから削除されます。「履歴」から元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록과 차트에서 제거됩니다. 기록에서 되돌릴 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从历史记录和图表中移除。你可以在“历史记录”中撤销。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này sẽ bị xóa khỏi lịch sử và biểu đồ. Bạn có thể hoàn tác trong Lịch sử."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimosso da cronologia e grafici. Puoi annullare l’operazione da Cronologia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt verwijderd uit de geschiedenis en grafieken. Je kunt dit ongedaan maken via Geschiedenis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişten ve grafiklerden kaldırılacak. Geçmiş bölümünden geri alabilirsin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan dihapus dari riwayat dan grafik. Kamu dapat membatalkannya dari Riwayat."
          }
        }
      }
    },
    "It will leave the active Journal and entry pickers. Its history, statistics and backup data will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es verschwindet aus dem aktiven Journal und den Eintragsauswahlen. Verlauf, Statistiken und Backup-Daten bleiben erhalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il quittera le journal actif et les sélecteurs de saisie. Son historique, ses statistiques et ses données de sauvegarde seront conservés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejará el diario activo y los selectores de registro. Se conservarán su historial, sus estadísticas y sus datos de copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele sairá do diário ativo e dos seletores de registro. Seu histórico, suas estatísticas e seus dados de backup serão mantidos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknie z aktywnego Dziennika i wyboru wpisów. Jego historia, statystyki i dane kopii zapasowej zostaną zachowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он исчезнет из активного журнала и списков выбора. Его история, статистика и данные копии сохранятся."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Він зникне з активного журналу та списків вибору. Його історія, статистика й дані копії збережуться."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այն կհեռանա ակտիվ օրագրից և ընտրացանկերից։ Դրա պատմությունը, վիճակագրությունը և պահուստային տվյալները կպահվեն։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なジャーナルと入力の選択肢から外れます。履歴、統計、バックアップデータは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 저널과 입력 선택 목록에서 빠집니다. 기록, 통계 및 백업 데이터는 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从使用中的记录和输入选择器中移除。其历史记录、统计和备份数据会保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mục này sẽ rời Nhật ký đang dùng và các danh sách chọn khi nhập. Lịch sử, thống kê và dữ liệu sao lưu vẫn được giữ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascerà il Diario attivo e i selettori di inserimento. Cronologia, statistiche e dati di backup verranno mantenuti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verdwijnt uit het actieve Dagboek en de invoerkiezers. De geschiedenis, statistieken en back-upgegevens blijven bewaard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin Günlükten ve giriş seçicilerinden çıkar. Geçmişi, istatistikleri ve yedek verileri korunur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan keluar dari Jurnal aktif dan pemilih entri. Riwayat, statistik, dan data cadangannya tetap disimpan."
          }
        }
      }
    },
