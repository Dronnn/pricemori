    "Mark a product as a favorite to find it quickly on your next visit.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiere ein Produkt als Favorit, um es bei deinem nächsten Besuch schnell zu finden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marquez un produit comme favori pour le retrouver rapidement lors de votre prochaine visite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca un producto como favorito para encontrarlo rápido en tu próxima visita."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque um produto como favorito para encontrá-lo rápido na sua próxima visita."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacz produkt jako ulubiony, aby szybko go znaleźć przy następnej wizycie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте товар как избранный, чтобы быстро найти его при следующем визите."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначте товар як обраний, щоб швидко знайти його наступного разу."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նշեք ապրանքը որպես ընտրյալ՝ հաջորդ այցելությանը արագ գտնելու համար։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品をお気に入りに登録すると、次回すぐに見つかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품을 즐겨찾기로 표시하면 다음 방문 때 빠르게 찾을 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将商品标为收藏，下次到访即可快速找到。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh dấu sản phẩm là yêu thích để lần sau tìm nhanh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrassegna un prodotto come preferito per trovarlo rapidamente alla prossima visita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeer een product als favoriet om het bij je volgende bezoek snel te vinden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ürünü favori olarak işaretle, böylece bir sonraki ziyaretinde hızlıca bulabilesin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandai produk sebagai favorit agar cepat ditemukan saat kunjungan berikutnya."
          }
        }
      }
    },
