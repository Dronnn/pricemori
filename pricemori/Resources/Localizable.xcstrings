    "Recording, search and favorites are directly on Journal. This menu is for other sections.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfassung, Suche und Favoriten findest du direkt im Journal. Dieses Menü ist für andere Bereiche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La saisie, la recherche et les favoris se trouvent directement dans le journal. Ce menu sert aux autres sections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro, la búsqueda y los favoritos están directamente en el diario. Este menú es para otras secciones."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro, busca e favoritos ficam diretamente no diário. Este menu é para outras seções."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywanie, wyszukiwanie i ulubione są bezpośrednio w Dzienniku. To menu służy do innych sekcji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись, поиск и избранное находятся прямо в журнале. Это меню — для других разделов."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запис, пошук і обране — безпосередньо в журналі. Це меню для інших розділів."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցումը, որոնումը և ընտրյալները հենց օրագրում են։ Այս ընտրացանկը այլ բաժինների համար է։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録、検索、お気に入りはジャーナルに直接あります。このメニューはその他の項目用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록, 검색 및 즐겨찾기는 저널에 바로 있습니다. 이 메뉴는 다른 항목용입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录、搜索和收藏直接在记录中。此菜单用于其他部分。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi, tìm kiếm và yêu thích nằm ngay trong Nhật ký. Menu này dành cho các mục khác."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione, ricerca e preferiti sono direttamente nel Diario. Questo menu serve per le altre sezioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreren, zoeken en favorieten staan direct in het Dagboek. Dit menu is voor de andere secties."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt, arama ve favoriler doğrudan Günlükte. Bu menü diğer bölümler içindir."
          }
        },
        "id": {
