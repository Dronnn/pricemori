    "One price is still useful. Keep it visible in history without inventing a trend." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein einzelner Preis ist trotzdem nützlich. Zeige ihn im Verlauf, ohne einen Trend zu erfinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un solo precio sigue siendo útil. Mantenlo visible en el historial sin inventar una tendencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un seul prix reste utile. Gardez-le visible dans l’historique sans inventer de tendance."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Մեկ գինն անգամ օգտակար է։ Թողեք այն պատմության մեջ՝ առանց միտում հորինելու։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu harga tetap berguna. Biarkan tetap terlihat di riwayat tanpa mengarang tren."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche un solo prezzo è utile. Tienilo visibile nella cronologia senza inventare un andamento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格が1件でも役に立ちます。傾向を作り出さず、履歴に表示しておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격이 하나여도 유용합니다. 추세를 만들지 않고 기록에 표시해 둡니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén prijs is nog steeds nuttig. Houd deze zichtbaar in de geschiedenis zonder een trend te verzinnen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna cena też jest przydatna. Pozostaw ją w historii, nie wymyślając trendu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um único preço ainda é útil. Mantenha-o visível no histórico sem inventar uma tendência."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Даже одна цена полезна. Оставьте её в истории, не выдумывая тренд."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek bir fiyat bile işe yarar. Bir eğilim uydurmadan geçmişte görünür tut."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навіть одна ціна корисна. Залиште її в історії, не вигадуючи тренд."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một mức giá vẫn hữu ích. Giữ nó trong lịch sử mà không tạo xu hướng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使只有一个价格也有用。将其保留在历史记录中，不虚构趋势。"
          }
        }
      }
    },
