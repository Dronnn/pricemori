          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наблюдения с датами, единицами и условиями\nНе восстанавливает журнал целиком"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarihli gözlemler, birimler ve koşullar\nTam bir günlüğü geri yüklemez"
