    "A multi-buy observation has an invalid minimum quantity.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mehrkauf-Beobachtung hat eine ungültige Mindestmenge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une observation d’achat multiple a une quantité minimale non valide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una observación de compra múltiple tiene una cantidad mínima no válida."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma observação de compra múltipla tem uma quantidade mínima inválida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwacja wielopakowa ma nieprawidłową minimalną ilość."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У наблюдения набора неверное минимальное количество."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спостереження набору має некоректну мінімальну кількість."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բազմագնում դիտարկումն ունի անվավեր նվազագույն քանակ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まとめ買いの観測記録の最小数量が無効です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다중 구매 관측 기록의 최소 수량이 올바르지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多件优惠记录的起购数量无效。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một lần ghi mua nhiều có số lượng tối thiểu không hợp lệ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una rilevazione di acquisto multiplo ha una quantità minima non valida."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een multiaankoopobservatie heeft een ongeldige minimale hoeveelheid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çoklu alım gözleminin minimum miktarı geçersiz."
          }
        },
