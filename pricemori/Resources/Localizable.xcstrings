    "You already saved this branch. Use it if it is the same place, or enter a clearer branch name.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast diese Filiale bereits gespeichert. Verwende sie, wenn es derselbe Ort ist, oder gib einen eindeutigeren Filialnamen ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez déjà enregistré cette succursale. Utilisez-la s’il s’agit du même endroit ou saisissez un nom plus précis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya guardaste esta sucursal. Úsala si es el mismo lugar o introduce un nombre más claro."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já salvou esta filial. Use-a se for o mesmo lugar ou insira um nome mais claro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten oddział jest już zapisany. Użyj go, jeśli to to samo miejsce, lub wpisz wyraźniejszą nazwę oddziału."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот филиал уже сохранён. Используйте его, если это то же место, или введите более точное название филиала."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це відділення вже збережено. Використайте його, якщо це те саме місце, або введіть точнішу назву відділення."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս մասնաճյուղն արդեն պահված է։ Օգտագործեք այն, եթե դա նույն տեղն է, կամ մուտքագրեք ավելի ճշգրիտ անվանում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この店舗は既に保存されています。同じ場所ならそれを使うか、より分かりやすい店舗名を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지점은 이미 저장되어 있습니다. 같은 곳이라면 그대로 사용하거나 더 명확한 지점 이름을 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已保存过此门店。如果是同一个地点，请直接使用；否则请输入更清晰的门店名称。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã lưu chi nhánh này. Dùng nếu là cùng địa điểm, hoặc nhập tên chi nhánh rõ hơn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai già salvato questa filiale. Usala se è lo stesso posto o inserisci un nome più chiaro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt deze vestiging al bewaard. Gebruik deze als het dezelfde plek is, of voer een duidelijkere vestigingsnaam in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şubeyi zaten kaydettin. Aynı yer ise onu kullan veya daha açık bir şube adı gir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu sudah menyimpan cabang ini. Gunakan jika tempatnya sama, atau masukkan nama cabang yang lebih jelas."
          }
        }
      }
    },
    "You can also add a branch while recording your first price.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auch beim Erfassen deines ersten Preises eine Filiale hinzufügen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi ajouter une succursale lors de l’enregistrement de votre premier prix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes añadir una sucursal al registrar tu primer precio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode adicionar uma filial ao registrar seu primeiro preço."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oddział możesz dodać także podczas zapisywania pierwszej ceny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Филиал можно добавить и во время записи первой цены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відділення можна додати й під час запису першої ціни."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարող եք մասնաճյուղ ավելացնել նաև առաջին գինը գրանցելիս։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の価格を記録するときに店舗も追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 가격을 기록할 때 지점도 추가할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在记录第一个价格时，你也可以添加门店。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn cũng có thể thêm chi nhánh khi ghi giá đầu tiên."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi anche aggiungere una filiale mentre registri il primo prezzo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ook een vestiging toevoegen terwijl je je eerste prijs registreert."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk fiyatını kaydederken bir şube de ekleyebilirsin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu juga dapat menambahkan cabang saat mencatat harga pertamamu."
          }
        }
      }
    },
    "You can enter an earlier observation. Comparisons follow observation dates, not the day you typed it. Future dates are not accepted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst eine frühere Beobachtung eingeben. Vergleiche richten sich nach dem Beobachtungsdatum, nicht nach dem Eingabetag. Zukünftige Daten werden nicht akzeptiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez saisir une observation antérieure. Les comparaisons suivent la date de l’observation, pas le jour de la saisie. Les dates futures ne sont pas acceptées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes introducir una observación anterior. Las comparaciones siguen la fecha de la observación, no el día en que la escribes. No se aceptan fechas futuras."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode inserir uma observação anterior. As comparações seguem a data da observação, não o dia em que você digitou. Datas futuras não são aceitas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz dodać wcześniejszą obserwację. Porównania opierają się na datach obserwacji, a nie na dniu wpisania. Przyszłe daty nie są akceptowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно добавить прежнее наблюдение. Сравнения идут по датам наблюдений, а не по дню ввода. Будущие даты не принимаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна додати попереднє спостереження. Порівняння йдуть за датами спостережень, а не за днем введення. Майбутні дати не приймаються."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Կարող եք մուտքագրել ավելի վաղ դիտարկում։ Համեմատությունները հիմնվում են դիտարկման ամսաթվերի, ոչ թե մուտքագրման օրվա վրա։ Ապագա ամսաթվերը չեն ընդունվում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の観測記録を入力できます。比較は入力した日ではなく観測日を基準にします。未来の日付は使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 관측 기록을 입력할 수 있습니다. 비교는 입력한 날짜가 아니라 관측 날짜를 따릅니다. 미래 날짜는 허용되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以输入更早的记录。比较依据记录日期，而不是输入日期。不接受未来日期。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể nhập lần ghi trước đó. So sánh dựa trên ngày ghi, không phải ngày bạn nhập. Không chấp nhận ngày trong tương lai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi inserire una rilevazione precedente. I confronti seguono le date di rilevazione, non il giorno in cui la digiti. Le date future non sono accettate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt een eerdere observatie invoeren. Vergelijkingen volgen de observatiedatums, niet de dag waarop je deze invoert. Toekomstige datums worden niet geaccepteerd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir gözlem girebilirsin. Karşılaştırmalar, girdiğin günü değil gözlem tarihlerini izler. Gelecek tarihler kabul edilmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamu dapat memasukkan observasi sebelumnya. Perbandingan mengikuti tanggal observasi, bukan hari saat kamu mengetiknya. Tanggal mendatang tidak diterima."
          }
        }
      }
    },
