    "Keep the exported file safe. The app cannot check whether you move or delete it later." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre die exportierte Datei sicher auf. Die App kann nicht prüfen, ob du sie später verschiebst oder löschst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda el archivo exportado en un lugar seguro. La app no puede comprobar si lo mueves o eliminas después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservez le fichier exporté en lieu sûr. L’app ne peut pas vérifier si vous le déplacez ou le supprimez plus tard."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պահեք արտահանված ֆայլը ապահով։ Հավելվածը չի կարող ստուգել՝ արդյոք այն հետագայում տեղափոխում կամ ջնջում եք։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan file yang diekspor dengan aman. App tidak dapat memeriksa apakah kamu memindahkan atau menghapusnya nanti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva il file esportato in un posto sicuro. L’app non può sapere se in seguito lo sposterai o eliminerai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き出したファイルは大切に保管してください。後で移動や削除をしてもアプリからは確認できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내보낸 파일을 안전하게 보관하세요. 나중에 파일을 이동하거나 삭제해도 앱에서 확인할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar het geëxporteerde bestand veilig. De app kan niet controleren of je het later verplaatst of verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadbaj o wyeksportowany plik. Aplikacja nie może sprawdzić, czy później go przeniesiesz lub usuniesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarde o arquivo exportado em local seguro. O app não pode verificar se você o mover ou excluir depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраните экспортированный файл. Приложение не может проверить, переместите вы его позже или удалите."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dışa aktarılan dosyayı güvende tut. Uygulama, dosyayı daha sonra taşıyıp taşımadığını veya silip silmediğini kontrol edemez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Збережіть експортований файл. Застосунок не може перевірити, чи ви його пізніше перемістите або видалите."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ tệp đã xuất an toàn. Ứng dụng không thể kiểm tra nếu sau này bạn di chuyển hay xóa tệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请妥善保管导出的文件。应用无法检测你之后是否移动或删除它。"
          }
        }
      }
