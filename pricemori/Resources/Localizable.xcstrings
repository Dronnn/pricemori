    "Try a different name or add this as a new product.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuche einen anderen Namen oder füge es als neues Produkt hinzu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre nom ou ajoutez-le comme nouveau produit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba otro nombre o añádelo como producto nuevo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente outro nome ou adicione como novo produto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj innej nazwy lub dodaj to jako nowy produkt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другое название или добавьте это как новый товар."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте іншу назву або додайте це як новий товар."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փորձեք այլ անվանում կամ ավելացրեք սա որպես նոր ապրանք։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の名前を試すか、新しい商品として追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 이름을 사용하거나 새 제품으로 추가하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试其他名称，或将其添加为新商品。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử tên khác hoặc thêm làm sản phẩm mới."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova un nome diverso o aggiungilo come nuovo prodotto."
          }
        },
        "nl": {
