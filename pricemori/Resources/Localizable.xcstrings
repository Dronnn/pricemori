    "Your lowest recorded price is different from another store’s last known price." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein niedrigster erfasster Preis unterscheidet sich vom zuletzt bekannten Preis eines anderen Geschäfts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu precio registrado más bajo difiere del último precio conocido de otra tienda."
