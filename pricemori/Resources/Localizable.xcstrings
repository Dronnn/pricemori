    "Appearance and text size follow your iPhone. Core recording and charts work offline.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Darstellung und Textgröße folgen deinem iPhone. Erfassung und Diagramme funktionieren auch offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apparence et la taille du texte suivent votre iPhone. La saisie et les graphiques fonctionnent hors ligne."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La apariencia y el tamaño del texto siguen tu iPhone. El registro y los gráficos funcionan sin conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A aparência e o tamanho do texto seguem o seu iPhone. O registro e os gráficos funcionam offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląd i rozmiar tekstu są zgodne z iPhone’em. Podstawowe zapisywanie i wykresy działają offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оформление и размер текста соответствуют iPhone. Основные записи и графики работают офлайн."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вигляд і розмір тексту відповідають iPhone. Основні записи й графіки працюють офлайн."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Տեսքը և տեքստի չափը համապատասխանում են ձեր iPhone-ին։ Հիմնական գրանցումը և գրաֆիկները աշխատում են անցանց։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観と文字サイズはiPhoneの設定に従います。記録とグラフの基本機能はオフラインで動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모양과 텍스트 크기는 iPhone 설정을 따릅니다. 핵심 기록 및 차트 기능은 오프라인으로 작동합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观和文字大小跟随 iPhone 设置。核心记录和图表功能可离线使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao diện và cỡ chữ theo iPhone của bạn. Chức năng ghi và biểu đồ cốt lõi hoạt động ngoại tuyến."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aspetto e dimensione del testo seguono il tuo iPhone. Registrazione e grafici principali funzionano offline."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weergave en tekstgrootte volgen je iPhone. Essentieel registreren en grafieken werken offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görünüm ve metin boyutu iPhone'unu takip eder. Temel kayıt ve grafikler çevrimdışı çalışır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilan dan ukuran teks mengikuti iPhone-mu. Pencatatan inti dan grafik berfungsi offline."
          }
        }
      }
    },
