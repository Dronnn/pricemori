    "Include the brand or variety if it matters. You can change the name later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm Marke oder Sorte auf, wenn es wichtig ist. Du kannst den Namen später ändern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la marque ou la variété si nécessaire. Vous pourrez changer le nom plus tard."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye la marca o la variedad si importa. Puedes cambiar el nombre más tarde."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua a marca ou a variedade se for importante. Você pode mudar o nome depois."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj markę lub odmianę, jeśli ma znaczenie. Nazwę możesz zmienić później."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите бренд или сорт, если это важно. Название можно изменить позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте бренд або сорт, якщо це важливо. Назву можна змінити пізніше."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ավելացրեք բրենդը կամ տեսակը, եթե դա կարևոր է։ Անվանումը կարող եք փոխել ավելի ուշ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な場合はブランドや種類を含めてください。名前は後で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요하다면 브랜드나 종류를 포함하세요. 이름은 나중에 바꿀 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如有必要，请包含品牌或品种。名称稍后可以更改。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thương hiệu hoặc loại nếu cần. Bạn có thể đổi tên sau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi la marca o la varietà se è importante. Potrai cambiare il nome in seguito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het merk of de variant toe als dat uitmaakt. Je kunt de naam later wijzigen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemliyse markayı veya çeşidi ekle. Adı daha sonra değiştirebilirsin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertakan merek atau varian jika penting. Kamu dapat mengubah namanya nanti."
          }
        }
      }
    },
    "Includes branch, date, amount, units and conditions": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Enthält Filiale, Datum, Betrag, Einheiten und Bedingungen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclut la succursale, la date, le montant, les unités et les conditions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye sucursal, fecha, importe, unidades y condiciones"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclui filial, data, valor, unidades e condições"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obejmuje oddział, datę, kwotę, jednostki i warunki"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включает филиал, дату, сумму, единицы и условия"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Включає відділення, дату, суму, одиниці й умови"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ներառում է մասնաճյուղ, ամսաթիվ, գումար, միավորներ և պայմաններ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗、日付、金額、単位、条件を含む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지점, 날짜, 금액, 단위 및 조건 포함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含门店、日期、金额、单位和条件"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bao gồm chi nhánh, ngày, số tiền, đơn vị và điều kiện"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Include filiale, data, importo, unità e condizioni"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclusief vestiging, datum, bedrag, eenheden en voorwaarden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şube, tarih, tutar, birimler ve koşullar dahil"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Termasuk cabang, tanggal, jumlah, satuan, dan syarat"
          }
        }
      }
    },
