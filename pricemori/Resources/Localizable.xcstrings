    "Different currencies and offer conditions are kept separate. Archived branches are hidden." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterschiedliche Währungen und Angebotsbedingungen bleiben getrennt. Archivierte Filialen sind ausgeblendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las distintas monedas y condiciones se mantienen separadas. Las sucursales archivadas están ocultas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les devises et conditions d’offre différentes restent séparées. Les succursales archivées sont masquées."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Տարբեր արժույթներն ու առաջարկի պայմանները պահվում են առանձին։ Արխիվացված մասնաճյուղերը թաքցված են։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
