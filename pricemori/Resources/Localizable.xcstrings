    "First comparable observation at this branch. No earlier price is known, so no change is calculated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erste vergleichbare Beobachtung in dieser Filiale. Es ist kein früherer Preis bekannt, daher wird keine Änderung berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Première observation comparable dans cette succursale. Aucun prix antérieur n’est connu, donc aucun changement n’est calculé."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primera observación comparable en esta sucursal. No se conoce un precio anterior, así que no se calcula ningún cambio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeira observação comparável nesta filial. Não há preço anterior conhecido, então nenhuma mudança é calculada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwsza porównywalna obserwacja w tym oddziale. Wcześniejsza cena nie jest znana, więc zmiana nie jest obliczana."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Первое сопоставимое наблюдение в этом филиале. Прежняя цена неизвестна, поэтому изменение не рассчитывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перше порівнюване спостереження в цьому відділенні. Попередня ціна невідома, тому зміна не обчислюється."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առաջին համեմատելի դիտարկումը այս մասնաճյուղում։ Նախորդ գինը հայտնի չէ, ուստի փոփոխությունը չի հաշվարկվում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この店舗での最初の比較可能な観測記録です。以前の価格がわからないため、変化は計算されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 지점의 첫 비교 가능 관측 기록입니다. 이전 가격을 알 수 없어 변동은 계산되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此门店的第一条可比记录。没有更早的价格，因此不计算变化。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần ghi so sánh được đầu tiên tại chi nhánh này. Không biết giá trước đó nên không tính thay đổi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima rilevazione confrontabile in questa filiale. Non si conosce un prezzo precedente, quindi non viene calcolata alcuna variazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerste vergelijkbare observatie in deze vestiging. Er is geen eerdere prijs bekend, dus er wordt geen wijziging berekend."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şubedeki ilk karşılaştırılabilir gözlem. Önceki bir fiyat bilinmediğinden değişiklik hesaplanmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Observasi pertama yang dapat dibandingkan di cabang ini. Tidak ada harga sebelumnya yang diketahui, jadi perubahan tidak dihitung."
          }
        }
      }
    },
