    "Charts and price changes will appear when there is enough comparable data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagramme und Preisänderungen erscheinen, sobald genug vergleichbare Daten vorliegen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les graphiques et les changements de prix apparaîtront lorsqu’il y aura assez de données comparables."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los gráficos y los cambios de precio aparecerán cuando haya suficientes datos comparables."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gráficos e mudanças de preço aparecerão quando houver dados comparáveis suficientes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykresy i zmiany cen pojawią się, gdy będzie dość porównywalnych danych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Графики и изменения цен появятся, когда будет достаточно сопоставимых данных."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Графіки та зміни цін з'являться, коли буде достатньо порівнюваних даних."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրաֆիկները և գնի փոփոխությունները կհայտնվեն, երբ բավարար համեմատելի տվյալներ լինեն։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較できるデータが十分になると、グラフと価格の変化が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비교할 데이터가 충분해지면 차트와 가격 변동이 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当有足够的可比数据时，将显示图表和价格变化。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biểu đồ và thay đổi giá sẽ hiện khi có đủ dữ liệu so sánh được."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafici e variazioni di prezzo appariranno quando ci saranno dati confrontabili sufficienti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafieken en prijswijzigingen verschijnen zodra er genoeg vergelijkbare gegevens zijn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafikler ve fiyat değişiklikleri, yeterli karşılaştırılabilir veri olduğunda görünür."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Grafik dan perubahan harga akan muncul saat data yang dapat dibandingkan cukup."
          }
        }
      }
    },
    "Choose a date before the latest observation.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Datum vor der letzten Beobachtung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une date antérieure à la dernière observation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una fecha anterior a la última observación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma data anterior à última observação."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz datę przed ostatnią obserwacją."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите дату до последнего наблюдения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть дату до останнього спостереження."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք ամսաթիվ մինչ վերջին դիտարկումը։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新の観測記録より前の日付を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 관측 기록보다 이전 날짜를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择早于最后一条记录的日期。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn ngày trước lần ghi gần nhất."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una data precedente all’ultima rilevazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een datum vóór de laatste observatie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son gözlemden önce bir tarih seç."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih tanggal sebelum observasi terakhir."
          }
        }
      }
    },
    "Choose a file, validate it and review changes\\nMerge is the default": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei wählen, prüfen und Änderungen ansehen\\nZusammenführen ist Standard"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier, validez-le et examinez les changements\\nLa fusion est l’option par défaut"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo, valídalo y revisa los cambios\\nFusionar es la opción predeterminada"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um arquivo, valide-o e revise as mudanças\\nMesclar é o padrão"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz plik, sprawdź go i przejrzyj zmiany\\nScalanie jest domyślne"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите файл, проверьте его и просмотрите изменения\\nПо умолчанию — объединение"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть файл, перевірте його та перегляньте зміни\\nТипово — об'єднання"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրեք ֆայլ, ստուգեք այն և դիտեք փոփոխությունները\\nԼռելյայն միավորումն է"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを選び、検証して変更を確認します\\n既定は統合です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 선택하고 검증한 뒤 변경 사항을 확인합니다\\n기본값은 병합입니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择文件、验证并查看更改\\n默认是合并"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tệp, xác thực và xem lại thay đổi\\nMặc định là gộp"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un file, convalidalo e rivedi le modifiche\\nUnisci è l’opzione predefinita"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een bestand, valideer het en controleer de wijzigingen\\nSamenvoegen is de standaard."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir dosya seç, doğrula ve değişiklikleri incele\\nVarsayılan olarak birleştirilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih file, validasi, dan tinjau perubahan\\nPenggabungan adalah default."
          }
        }
      }
    },
    "Choose a format, then save or share the file using your iPhone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Format und speichere oder teile die Datei dann mit deinem iPhone."
          }
        },
        "fr": {
