    "The package got smaller. The unit price shows the increase.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Packung ist kleiner geworden. Der Grundpreis zeigt den Anstieg."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet a rétréci. Le prix unitaire montre la hausse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete se ha hecho más pequeño. El precio por unidad muestra el aumento."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pacote ficou menor. O preço por unidade mostra o aumento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opakowanie się zmniejszyło. Cena jednostkowa pokazuje wzrost."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Упаковка стала меньше. Цена за единицу показывает рост."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Упаковка стала меншою. Ціна за одиницю показує зростання."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փաթեթը փոքրացել է։ Միավորի գինը ցույց է տալիս աճը։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージが小さくなりました。値上がりは単位価格に表れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지가 작아졌습니다. 인상분은 단위 가격에 나타납니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包装变小了。单位价格体现了涨幅。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói đã nhỏ đi. Giá đơn vị cho thấy mức tăng."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La confezione è diventata più piccola. Il prezzo unitario mostra l’aumento."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verpakking is kleiner geworden. De eenheidsprijs toont de stijging."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket küçüldü. Birim fiyat artışı gösteriyor."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemasannya menjadi lebih kecil. Harga satuan menunjukkan kenaikannya."
          }
        }
      }
    },
    "The package size stayed the same. Unit prices move with the package price.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Packungsgröße ist gleich geblieben. Der Grundpreis bewegt sich mit dem Packungspreis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La taille du paquet est restée la même. Le prix unitaire évolue avec le prix du paquet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tamaño del paquete no ha cambiado. El precio por unidad varía con el precio del paquete."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tamanho do pacote permaneceu o mesmo. O preço por unidade varia com o preço do pacote."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozmiar opakowania się nie zmienił. Ceny jednostkowe zmieniają się wraz z ceną opakowania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Размер упаковки не изменился. Цены за единицу меняются вместе с ценой упаковки."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмір упаковки не змінився. Ціни за одиницю змінюються разом із ціною упаковки."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փաթեթի չափը մնացել է նույնը։ Միավորի գները փոխվում են փաթեթի գնի հետ։"
          }
        },
        "ja": {
          "stringUnit": {
