        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գնի փոփոխության համար պետք է երկու դիտարկում նույն մասնաճյուղով, արժույթով, միավորներով և պայմաններով։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
