    "Record a shelf price or what you paid. Compare it with your own earlier observations.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasse einen Regalpreis oder was du bezahlt hast. Vergleiche ihn mit deinen früheren Beobachtungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un prix en rayon ou ce que vous avez payé. Comparez-le avec vos observations précédentes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un precio de estantería o lo que pagaste. Compáralo con tus observaciones anteriores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre um preço de prateleira ou o que você pagou. Compare com suas observações anteriores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz cenę z półki lub kwotę, którą zapłacono. Porównaj ją z własnymi wcześniejszymi obserwacjami."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите цену на полке или сумму, которую заплатили. Сравните с собственными прежними наблюдениями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть ціну на полиці або суму, яку сплатили. Порівняйте її з власними попередніми спостереженнями."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրանցեք դարակի գինը կամ վճարված գումարը։ Համեմատեք այն ձեր նախորդ դիտարկումների հետ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "棚の価格または支払った金額を記録します。以前の自分の観測記録と比較できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진열 가격이나 실제 결제 금액을 기록하세요. 이전 관측 기록과 비교할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录货架价格或你实际支付的价格，并与你之前的记录进行比较。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi giá trên kệ hoặc số tiền bạn đã trả. So sánh với các lần ghi trước của bạn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un prezzo a scaffale o quello che hai pagato. Confrontalo con le tue rilevazioni precedenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer een schapprijs of wat je hebt betaald. Vergelijk deze met je eerdere observaties."
          }
        },
        "tr": {
