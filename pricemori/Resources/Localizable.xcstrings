    "Restored products return to the Journal with all their earlier prices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhergestellte Produkte kehren mit allen früheren Preisen ins Journal zurück."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les produits restaurés reviennent dans le journal avec tous leurs prix antérieurs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los productos restaurados vuelven al diario con todos sus precios anteriores."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Produtos restaurados voltam ao diário com todos os seus preços anteriores."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócone produkty wracają do Dziennika ze wszystkimi wcześniejszymi cenami."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановленные товары возвращаются в журнал со всеми прежними ценами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлені товари повертаються до журналу з усіма попередніми цінами."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերականգնված ապրանքները վերադառնում են օրագիր իրենց բոլոր նախորդ գներով։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元した商品は、以前の価格すべてとともにジャーナルに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원된 제품은 이전 가격과 함께 저널로 돌아옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复的商品会连同其之前的所有价格回到记录中。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sản phẩm được phục hồi trở lại Nhật ký cùng toàn bộ giá trước đó."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prodotti ripristinati tornano nel Diario con tutti i loro prezzi precedenti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelde producten keren terug in het Dagboek met al hun eerdere prijzen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri yüklenen ürünler, önceki tüm fiyatlarıyla Günlüğe döner."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk yang dipulihkan kembali ke Jurnal dengan semua harga sebelumnya."
          }
        }
      }
    },
    "Restoring makes the branch available for new prices and regular comparisons again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Wiederherstellung ist die Filiale wieder für neue Preise und reguläre Vergleiche verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La restauration rend la succursale de nouveau disponible pour de nouveaux prix et des comparaisons normales."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al restaurar, la sucursal vuelve a estar disponible para precios nuevos y comparaciones normales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar torna a filial disponível novamente para novos preços e comparações regulares."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywrócenie ponownie udostępnia oddział do nowych cen i porównań regularnych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление снова делает филиал доступным для новых цен и обычных сравнений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновлення знову робить відділення доступним для нових цін і звичайних порівнянь."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Վերականգնումը կրկին հասանելի է դարձնում մասնաճյուղը նոր գների և սովորական համեմատությունների համար։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
