    "Each bar compares this product at the same branch and unit. Products with fewer than two comparable observations are excluded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Balken vergleicht dieses Produkt in derselben Filiale und Einheit. Produkte mit weniger als zwei vergleichbaren Beobachtungen werden ausgeschlossen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque barre compare ce produit dans la même succursale et la même unité. Les produits avec moins de deux observations comparables sont exclus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra compara este producto en la misma sucursal y unidad. Los productos con menos de dos observaciones comparables se excluyen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada barra compara este produto na mesma filial e unidade. Produtos com menos de duas observações comparáveis são excluídos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy słupek porównuje ten produkt w tym samym oddziale i jednostce. Produkty z mniej niż dwiema porównywalnymi obserwacjami są pomijane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый столбец сравнивает этот товар в одном филиале и одной единице. Товары с менее чем двумя сопоставимыми наблюдениями исключаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен стовпець порівнює цей товар у тому самому відділенні й одиниці. Товари з менш ніж двома порівнюваними спостереженнями виключаються."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր սյուն համեմատում է այս ապրանքը նույն մասնաճյուղում և միավորում։ Երկուսից քիչ համեմատելի դիտարկում ունեցող ապրանքները բացառվում են։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各バーは、同じ店舗・同じ単位でのこの商品を比較します。比較できる観測記録が2件未満の商品は除外されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 막대는 같은 지점과 같은 단위에서 이 제품을 비교합니다. 비교 가능한 관측 기록이 2개 미만인 제품은 제외됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每根柱子比较同一门店、同一单位下的此商品。可比记录少于两条的商品会被排除。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi cột so sánh sản phẩm này tại cùng chi nhánh và đơn vị. Sản phẩm có dưới hai lần ghi so sánh được sẽ bị loại."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni barra confronta questo prodotto nella stessa filiale e unità. I prodotti con meno di due rilevazioni confrontabili sono esclusi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke balk vergelijkt dit product in dezelfde vestiging en eenheid. Producten met minder dan twee vergelijkbare observaties worden uitgesloten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her çubuk bu ürünü aynı şube ve birimde karşılaştırır. İki karşılaştırılabilir gözlemden azı olan ürünler hariç tutulur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap batang membandingkan produk ini di cabang dan satuan yang sama. Produk dengan kurang dari dua observasi yang dapat dibandingkan tidak disertakan."
          }
        }
      }
    },
    "Each brand and variety has its own history. Similar names are not merged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Marke und Sorte hat einen eigenen Verlauf. Ähnliche Namen werden nicht zusammengeführt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque marque et variété a son propre historique. Les noms similaires ne sont pas fusionnés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada marca y variedad tiene su propio historial. Los nombres similares no se fusionan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada marca e variedade tem seu próprio histórico. Nomes semelhantes não são mesclados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda marka i odmiana mają własną historię. Podobne nazwy nie są scalane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого бренда и сорта своя история. Похожие названия не объединяются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен бренд і сорт мають власну історію. Схожі назви не об'єднуються."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Յուրաքանչյուր բրենդ և տեսակ ունի իր պատմությունը։ Նման անվանումները չեն միավորվում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブランドと種類ごとに個別の履歴があります。似た名前でも統合されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브랜드와 종류마다 별도의 기록이 있습니다. 비슷한 이름이라도 병합되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个品牌和品种都有各自的历史记录。相似名称不会被合并。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi thương hiệu và loại có lịch sử riêng. Tên giống nhau không được gộp."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni marca e varietà ha la propria cronologia. I nomi simili non vengono uniti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk merk en elke variant heeft een eigen geschiedenis. Vergelijkbare namen worden niet samengevoegd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her marka ve çeşidin kendi geçmişi vardır. Benzer adlar birleştirilmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap merek dan varian memiliki riwayatnya sendiri. Nama yang mirip tidak digabungkan."
          }
        }
      }
    },
