        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս գինը կնշվի «Պահանջվում է քարտ»։ Այն չի փոխարինի սովորական գների համեմատությունը։"
          }
        },
        "ja": {
          "stringUnit": {
