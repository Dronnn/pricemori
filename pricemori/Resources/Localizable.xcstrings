        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confirme que os mesmos requisitos e a quantidade mínima se aplicam hoje. Para outra oferta, registre um novo preço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите, что сегодня действуют те же условия и минимальное количество. Для другого предложения запишите новую цену."
