    "Selecting a currency does not convert the amount. Different currencies have separate comparisons and charts.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl einer Währung rechnet den Betrag nicht um. Verschiedene Währungen haben getrennte Vergleiche und Diagramme."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une devise ne convertit pas le montant. Les différentes devises ont des comparaisons et des graphiques séparés."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir una moneda no convierte el importe. Las distintas monedas tienen comparaciones y gráficos separados."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolher uma moeda não converte o valor. Moedas diferentes têm comparações e gráficos separados."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana waluty nie przelicza kwoty. Różne waluty mają osobne porównania i wykresy."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор валюты не пересчитывает сумму. У разных валют отдельные сравнения и графики."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір валюти не перераховує суму. Різні валюти мають окремі порівняння та графіки."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արժույթ ընտրելը չի փոխարկում գումարը։ Տարբեր արժույթներ ունեն առանձին համեմատություններ և գրաֆիկներ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通貨を選択しても金額は換算されません。通貨ごとに比較とグラフは別々になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통화를 선택해도 금액이 변환되지는 않습니다. 통화마다 비교와 차트가 따로 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择货币不会转换金额。不同货币有各自的比较和图表。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn tiền tệ không quy đổi số tiền. Mỗi loại tiền tệ có so sánh và biểu đồ riêng."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionare una valuta non converte l’importo. Valute diverse hanno confronti e grafici separati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een valuta kiezen rekent het bedrag niet om. Verschillende valuta hebben aparte vergelijkingen en grafieken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para birimi seçmek tutarı dönüştürmez. Farklı para birimlerinin karşılaştırmaları ve grafikleri ayrıdır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memilih mata uang tidak mengonversi jumlah. Mata uang berbeda memiliki perbandingan dan grafik terpisah."
          }
        }
      }
    },
