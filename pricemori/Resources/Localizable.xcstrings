    "Some records are missing required fields, or the file is not a full backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einigen Einträgen fehlen Pflichtfelder, oder die Datei ist kein vollständiges Backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des champs obligatoires manquent dans certains enregistrements, ou le fichier n’est pas une sauvegarde complète."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A algunos registros les faltan campos obligatorios, o el archivo no es una copia completa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns registros estão sem campos obrigatórios, ou o arquivo não é um backup completo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W niektórych wpisach brakuje wymaganych pól lub plik nie jest pełną kopią zapasową."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В некоторых записях нет обязательных полей, или файл не является полной копией."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У деяких записах бракує обов'язкових полів, або файл не є повною копією."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Որոշ գրառումներում բացակայում են պարտադիր դաշտեր, կամ ֆայլը ամբողջական պահուստային պատճեն չէ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の記録に必須項目がないか、ファイルが完全バックアップではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 기록에 필수 항목이 없거나 파일이 전체 백업이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分记录缺少必填字段，或者该文件不是完整备份。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số bản ghi thiếu trường bắt buộc, hoặc tệp không phải bản sao lưu đầy đủ."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni record non hanno i campi obbligatori oppure il file non è un backup completo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige records missen verplichte velden, of het bestand is geen volledige back-up."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı kayıtlarda zorunlu alanlar eksik veya dosya tam bir yedek değil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa catatan tidak memiliki kolom wajib, atau file bukan cadangan lengkap."
          }
        }
      }
    },
    "Some records are missing required fields. The file cannot be safely restored.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einigen Einträgen fehlen Pflichtfelder. Die Datei kann nicht sicher wiederhergestellt werden."
