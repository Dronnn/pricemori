        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저널은 이 기기에 안전하게 보관되어 있습니다. 삭제된 관측 기록은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
