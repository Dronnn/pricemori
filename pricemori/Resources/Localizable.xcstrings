    "If you do not know the size, save the package price only. Unit comparison will be unavailable." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du die Größe nicht kennst, speichere nur den Packungspreis. Der Grundpreisvergleich ist dann nicht verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no sabes el tamaño, guarda solo el precio del paquete. La comparación por unidad no estará disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous ne connaissez pas la taille, enregistrez uniquement le prix du paquet. La comparaison au prix unitaire sera indisponible."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե չափը հայտնի չէ, պահեք միայն փաթեթի գինը։ Միավորի համեմատությունը հասանելի չի լինի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika tidak tahu ukurannya, simpan harga kemasan saja. Perbandingan satuan tidak akan tersedia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se non conosci il formato, salva solo il prezzo della confezione. Il confronto unitario non sarà disponibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量がわからない場合は、パッケージ価格のみを保存してください。単位あたりの比較は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "용량을 모르면 패키지 가격만 저장하세요. 단위 가격 비교는 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de grootte niet weet, bewaar dan alleen de verpakkingsprijs. Eenheidsvergelijking is dan niet beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli nie znasz rozmiaru, zapisz tylko cenę opakowania. Porównanie jednostkowe będzie niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se você não sabe o tamanho, salve apenas o preço do pacote. A comparação por unidade não estará disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если размер неизвестен, сохраните только цену упаковки. Сравнение за единицу будет недоступно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boyutu bilmiyorsan yalnızca paket fiyatını kaydet. Birim karşılaştırması kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо розмір невідомий, збережіть лише ціну упаковки. Порівняння за одиницю буде недоступне."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu không biết dung tích, chỉ lưu giá gói. Sẽ không so sánh được theo đơn vị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果不知道规格，只保存包装价格即可。将无法进行单位价格比较。"
          }
        }
      }
    },
