          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met één product dat je regelmatig koopt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli aldığın bir ürünle başla."
          }
        },
