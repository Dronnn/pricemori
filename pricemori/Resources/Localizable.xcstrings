    "No missing prices are guessed. Excluded observations remain visible in history.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Preise werden nicht geschätzt. Ausgeschlossene Beobachtungen bleiben im Verlauf sichtbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun prix manquant n’est deviné. Les observations exclues restent visibles dans l’historique."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se adivinan los precios que faltan. Las observaciones excluidas siguen visibles en el historial."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preços ausentes não são estimados. Observações excluídas continuam visíveis no histórico."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brakujące ceny nie są zgadywane. Pominięte obserwacje pozostają widoczne w historii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропущенные цены не угадываются. Исключённые наблюдения остаются видны в истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропущені ціни не вгадуються. Виключені спостереження залишаються видимими в історії."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բացակայող գները չեն գուշակվում։ Բացառված դիտարկումները մնում են տեսանելի պատմության մեջ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "欠けている価格を推測することはありません。除外された観測記録は履歴に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빠진 가격을 추측하지 않습니다. 제외된 관측 기록은 기록에 그대로 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会推测缺失的价格。被排除的记录仍会显示在历史记录中。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đoán giá còn thiếu. Các lần ghi bị loại vẫn hiện trong lịch sử."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi mancanti non vengono stimati. Le rilevazioni escluse restano visibili nella cronologia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontbrekende prijzen worden niet geschat. Uitgesloten observaties blijven zichtbaar in de geschiedenis."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksik fiyatlar tahmin edilmez. Hariç tutulan gözlemler geçmişte görünür kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga yang hilang tidak ditebak. Observasi yang dikecualikan tetap terlihat di riwayat."
          }
        }
      }
    },
