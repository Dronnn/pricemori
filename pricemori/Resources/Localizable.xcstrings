        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հաստատեք, որ այսօր գործում են նույն պայմաններն ու նվազագույն քանակը։ Այլ առաջարկի համար գրանցեք նոր գին։"
