    "Regular and conditional prices have different eligibility, so no like-for-like change is calculated between them.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reguläre und bedingte Preise haben unterschiedliche Voraussetzungen, daher wird zwischen ihnen keine gleichwertige Änderung berechnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix normaux et conditionnels ont des conditions d’éligibilité différentes ; aucun changement comparable n’est calculé entre eux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios normales y condicionales tienen distinta elegibilidad, así que no se calcula un cambio equivalente entre ellos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preços regulares e condicionais têm elegibilidade diferente, então nenhuma mudança equivalente é calculada entre eles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceny regularne i warunkowe mają różne warunki dostępu, więc nie oblicza się między nimi zmiany jak do jak."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У обычных и условных цен разные условия доступа, поэтому изменение между ними не рассчитывается."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звичайні та умовні ціни мають різні умови доступу, тому зміна між ними не обчислюється."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սովորական և պայմանական գներն ունեն իրավասության տարբեր պայմաններ, ուստի նրանց միջև համարժեք փոփոխություն չի հաշվարկվում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常価格と条件付き価格は適用条件が異なるため、両者の間で同等の変化は計算されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정상가와 조건부 가격은 적용 조건이 달라 서로 간에 동등한 변동을 계산하지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "常规价格和有条件价格的适用条件不同，因此不会在两者之间计算同类变化。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá thường và giá có điều kiện có điều kiện áp dụng khác nhau nên không tính thay đổi tương đương giữa chúng."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi normali e quelli condizionati hanno idoneità diverse, quindi tra loro non viene calcolata una variazione comparabile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Normale en voorwaardelijke prijzen hebben verschillende geschiktheid, dus er wordt geen gelijkwaardige wijziging tussen berekend."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normal ve koşullu fiyatların uygunlukları farklıdır, bu nedenle aralarında eşdeğer bir değişiklik hesaplanmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga normal dan bersyarat memiliki kelayakan berbeda, jadi perubahan setara tidak dihitung di antara keduanya."
          }
        }
      }
    },
