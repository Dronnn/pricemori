          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký được lưu trên iPhone này. Hãy giữ bản sao lưu đầy đủ ở nơi bạn có thể truy cập sau này."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
