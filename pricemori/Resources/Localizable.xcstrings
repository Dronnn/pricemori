    "Your lowest recorded price is different from another store’s last known price.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein niedrigster erfasster Preis unterscheidet sich vom zuletzt bekannten Preis eines anderen Geschäfts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prix enregistré le plus bas diffère du dernier prix connu d’un autre magasin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu precio registrado más bajo difiere del último precio conocido de otra tienda."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu menor preço registrado difere do último preço conhecido de outra loja."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja najniższa zapisana cena różni się od ostatniej znanej ceny w innym sklepie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша самая низкая записанная цена отличается от последней известной цены в другом магазине."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша найнижча записана ціна відрізняється від останньої відомої ціни в іншому магазині."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր ամենացածր գրանցված գինը տարբերվում է այլ խանութի վերջին հայտնի գնից։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録した最安価格は、別の店舗で最後に確認した価格と異なります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록된 최저 가격이 다른 매장의 마지막 확인 가격과 다릅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你记录的最低价格与另一家门店的最近已知价格不同。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá thấp nhất bạn đã ghi khác với giá gần nhất của cửa hàng khác."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo prezzo registrato più basso è diverso dall’ultimo prezzo noto di un altro negozio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je laagst geregistreerde prijs verschilt van de laatst bekende prijs van een andere winkel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen en düşük fiyatın, başka bir mağazanın bilinen son fiyatından farklı."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga terendah yang kamu catat berbeda dari harga terakhir yang diketahui di toko lain."
          }
        }
      }
    },
