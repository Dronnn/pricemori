        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "店舗ごとに個別に保存してください。同じチェーンの店舗でも価格が異なることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
