    },
    "A price change needs two observations with the same branch, currency, units and conditions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Preisänderung braucht zwei Beobachtungen mit derselben Filiale, Währung, Einheit und Bedingung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un changement de prix nécessite deux observations avec la même succursale, devise, unité et condition."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio de precio necesita dos observaciones con la misma sucursal, moneda, unidad y condición."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma mudança de preço precisa de duas observações com a mesma filial, moeda, unidade e condição."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiana ceny wymaga dwóch obserwacji z tym samym oddziałem, walutą, jednostkami i warunkami."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для изменения цены нужны два наблюдения с одним филиалом, валютой, единицами и условиями."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміна ціни потребує двох спостережень з тим самим відділенням, валютою, одиницями й умовами."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գնի փոփոխության համար պետք է երկու դիտարկում նույն մասնաճյուղով, արժույթով, միավորներով և պայմաններով։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格の変化には、店舗・通貨・単位・条件が同じ観測記録が2件必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격 변동을 계산하려면 지점, 통화, 단위 및 조건이 같은 관측 기록이 2개 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计算价格变化需要两条门店、货币、单位和条件相同的记录。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi giá cần hai lần ghi có cùng chi nhánh, tiền tệ, đơn vị và điều kiện."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una variazione di prezzo richiede due rilevazioni con la stessa filiale, valuta, unità e condizioni."
          }
        },
