    "Locations are separate, even when the chain name is the same." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standorte sind getrennt, auch wenn der Kettenname derselbe ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ubicaciones son independientes, aunque el nombre de la cadena sea el mismo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les lieux sont distincts, même lorsque le nom de la chaîne est le même."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Վայրերն առանձին են, նույնիսկ երբ ցանցի անվանումը նույնն է։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokasi terpisah, meskipun nama jaringannya sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I luoghi sono separati, anche quando il nome della catena è lo stesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェーン名が同じでも、店舗は別々に扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체인 이름이 같아도 매장은 별개로 처리됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locaties zijn apart, ook als de ketennaam hetzelfde is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lokalizacje są osobne, nawet gdy nazwa sieci jest ta sama."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locais são separados, mesmo quando o nome da rede é o mesmo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Локации раздельны, даже если название сети одно и то же."
