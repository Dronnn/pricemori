    "It will leave the active Journal and entry pickers. Its history, statistics and backup data will be kept." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es verschwindet aus dem aktiven Journal und den Eintragsauswahlen. Verlauf, Statistiken und Backup-Daten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejará el diario activo y los selectores de registro. Se conservarán su historial, sus estadísticas y sus datos de copia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il quittera le journal actif et les sélecteurs de saisie. Son historique, ses statistiques et ses données de sauvegarde seront conservés."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այն կհեռանա ակտիվ օրագրից և ընտրացանկերից։ Դրա պատմությունը, վիճակագրությունը և պահուստային տվյալները կպահվեն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan keluar dari Jurnal aktif dan pemilih entri. Riwayat, statistik, dan data cadangannya tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lascerà il Diario attivo e i selettori di inserimento. Cronologia, statistiche e dati di backup verranno mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なジャーナルと入力の選択肢から外れます。履歴、統計、バックアップデータは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성 저널과 입력 선택 목록에서 빠집니다. 기록, 통계 및 백업 데이터는 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verdwijnt uit het actieve Dagboek en de invoerkiezers. De geschiedenis, statistieken en back-upgegevens blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zniknie z aktywnego Dziennika i wyboru wpisów. Jego historia, statystyki i dane kopii zapasowej zostaną zachowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele sairá do diário ativo e dos seletores de registro. Seu histórico, suas estatísticas e seus dados de backup serão mantidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Он исчезнет из активного журнала и списков выбора. Его история, статистика и данные копии сохранятся."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkin Günlükten ve giriş seçicilerinden çıkar. Geçmişi, istatistikleri ve yedek verileri korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Він зникне з активного журналу та списків вибору. Його історія, статистика й дані копії збережуться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mục này sẽ rời Nhật ký đang dùng và các danh sách chọn khi nhập. Lịch sử, thống kê và dữ liệu sao lưu vẫn được giữ."
