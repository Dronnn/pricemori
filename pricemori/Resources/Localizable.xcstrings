          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日も同じ適用条件と最低購入数であることを確認してください。別の特典の場合は新しい価格を記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
