    "Save each branch separately. Two branches of the same chain may charge different prices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere jede Filiale einzeln. Zwei Filialen derselben Kette können unterschiedliche Preise verlangen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez chaque succursale séparément. Deux succursales d’une même chaîne peuvent pratiquer des prix différents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cada sucursal por separado. Dos sucursales de la misma cadena pueden cobrar precios distintos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve cada filial separadamente. Duas filiais da mesma rede podem cobrar preços diferentes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj każdy oddział osobno. Dwa oddziały tej samej sieci mogą mieć różne ceny."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняйте каждый филиал отдельно. Два филиала одной сети могут держать разные цены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте кожне відділення окремо. Два відділення однієї мережі можуть мати різні ціни."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պահեք յուրաքանչյուր մասնաճյուղ առանձին։ Նույն ցանցի երկու մասնաճյուղեր կարող են տարբեր գներ ունենալ։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗ごとに個別に保存してください。同じチェーンの店舗でも価格が異なることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지점별로 따로 저장하세요. 같은 체인의 두 지점이라도 가격이 다를 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请分别保存每个门店。同一连锁的两家门店可能价格不同。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu riêng từng chi nhánh. Hai chi nhánh cùng chuỗi có thể có giá khác nhau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva ogni filiale separatamente. Due filiali della stessa catena possono applicare prezzi diversi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar elke vestiging apart. Twee vestigingen van dezelfde keten kunnen verschillende prijzen rekenen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şubeyi ayrı kaydet. Aynı zincirin iki şubesi farklı fiyatlar uygulayabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan setiap cabang secara terpisah. Dua cabang dari jaringan yang sama dapat menetapkan harga berbeda."
          }
        }
      }
    },
