    "Must buy %lld packages. Total outlay: %@ %@. This total replaces the package price in the entry form.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst %lld Packungen kaufen. Gesamtaufwand: %@ %@. Dieser Betrag ersetzt im Eintragsformular den Packungspreis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez acheter %lld paquets. Dépense totale : %@ %@. Ce total remplace le prix du paquet dans le formulaire de saisie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes comprar %lld paquetes. Gasto total: %@ %@. Este total sustituye el precio del paquete en el formulario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É preciso comprar %lld pacotes. Gasto total: %@ %@. Este total substitui o preço do pacote no formulário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trzeba kupić %lld opakowań. Łączny koszt: %@ %@. Ta kwota zastępuje cenę opakowania w formularzu wpisu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужно купить упаковок: %lld. Общая сумма: %@ %@. Эта сумма заменяет цену упаковки в форме."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно купити упаковок: %lld. Загальна сума: %@ %@. Ця сума замінює ціну упаковки у формі."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Պետք է գնել %lld փաթեթ։ Ընդհանուր գումարը՝ %@ %@։ Այս գումարը փոխարինում է փաթեթի գինը մուտքի ձևում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lldパッケージの購入が必要です。合計支出: %@ %@。この合計は入力フォームのパッケージ価格に代えて使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 %lld개를 구매해야 합니다. 총 지출: %@ %@. 이 총액은 입력 양식의 패키지 가격을 대신합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "必须购买 %lld 个包装。总支出：%@ %@。此总额将替代输入表单中的包装价格。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phải mua %lld gói. Tổng chi: %@ %@. Tổng này thay thế giá gói trong biểu mẫu nhập."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi acquistare %lld confezioni. Spesa totale: %@ %@. Questo totale sostituisce il prezzo della confezione nel modulo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je moet %lld verpakkingen kopen. Totale uitgave: %@ %@. Dit totaal vervangt de verpakkingsprijs in het invoerformulier."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paket alman gerekiyor. Toplam harcama: %@ %@. Bu toplam, giriş formundaki paket fiyatının yerini alır."
