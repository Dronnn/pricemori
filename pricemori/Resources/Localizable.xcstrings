    "Products, branches, observations and settings\nIncludes archived data": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkte, Filialen, Beobachtungen und Einstellungen\nEnthält archivierte Daten"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Produits, succursales, observations et réglages\nInclut les données archivées"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Productos, sucursales, observaciones y ajustes\nIncluye datos archivados"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Produtos, filiais, observações e ajustes\nInclui dados arquivados"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Produkty, oddziały, obserwacje i ustawienia\nObejmuje zarchiwizowane dane"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Товары, филиалы, наблюдения и настройки\nВключая архивные данные"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Товари, відділення, спостереження й налаштування\nВключає архівні дані"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ապրանքներ, մասնաճյուղեր, դիտարկումներ և կարգավորումներ\nՆերառում է արխիվացված տվյալները"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品、店舗、観測記録、設定\nアーカイブ済みデータを含む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품, 지점, 관측 기록 및 설정\n보관된 데이터 포함"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商品、门店、记录和设置\n包含已归档数据"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sản phẩm, chi nhánh, lần ghi và cài đặt\nBao gồm dữ liệu đã lưu trữ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prodotti, filiali, rilevazioni e impostazioni\nInclude i dati archiviati"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Producten, vestigingen, observaties en instellingen\nInclusief gearchiveerde gegevens"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ürünler, şubeler, gözlemler ve ayarlar\nArşivlenmiş veriler dahil"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk, cabang, observasi, dan pengaturan\nTermasuk data yang diarsipkan"
          }
        }
      }
    },
