    "Lines connect recorded points; prices between them are unknown.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Linien verbinden erfasste Punkte; Preise dazwischen sind unbekannt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lignes relient les points enregistrés ; les prix entre eux sont inconnus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
