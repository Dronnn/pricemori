    "Both choices are reviewed before anything is imported.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Optionen werden geprüft, bevor etwas importiert wird."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux choix sont examinés avant toute importation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambas opciones se revisan antes de importar nada."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas opções são revisadas antes de qualquer importação."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oba wybory są sprawdzane, zanim cokolwiek zostanie zaimportowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба варианта проверяются до того, как что-либо будет импортировано."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обидва варіанти перевіряються, перш ніж щось буде імпортовано."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Երկու ընտրություններն էլ ստուգվում են նախքան որևէ բան ներմուծելը։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの選択も、読み込み前に確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 선택 모두 가져오기 전에 검토됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种选择都会在导入前接受检查。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cả hai lựa chọn đều được xem lại trước khi nhập."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambe le scelte vengono esaminate prima di importare qualsiasi cosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide keuzes worden bekeken voordat er iets wordt geïmporteerd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iki seçenek de herhangi bir şey içe aktarılmadan önce incelenir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kedua pilihan ditinjau sebelum apa pun diimpor."
          }
        }
      }
    },
