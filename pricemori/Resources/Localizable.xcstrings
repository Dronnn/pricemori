    "Start with one product. Its package size and store are recorded with the price.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginne mit einem Produkt. Packungsgröße und Geschäft werden mit dem Preis gespeichert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez par un produit. Sa taille de paquet et son magasin sont enregistrés avec le prix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza con un producto. Su tamaño de paquete y su tienda se guardan con el precio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece com um produto. O tamanho do pacote e a loja são salvos com o preço."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij od jednego produktu. Rozmiar opakowania i sklep są zapisywane razem z ceną."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните с одного товара. Размер упаковки и магазин записываются вместе с ценой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Почніть з одного товару. Розмір упаковки та магазин записуються разом з ціною."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Սկսեք մեկ ապրանքից։ Փաթեթի չափը և խանութը գրանցվում են գնի հետ միասին։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商品を1つから始めましょう。パッケージの容量と店舗が価格と一緒に記録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제품 하나로 시작하세요. 패키지 용량과 매장이 가격과 함께 기록됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从一样商品开始。包装规格和门店会与价格一起记录。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bắt đầu với một sản phẩm. Dung tích gói và cửa hàng được ghi cùng giá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia con un prodotto. Formato della confezione e negozio vengono registrati con il prezzo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin met één product. De verpakkingsgrootte en winkel worden bij de prijs opgeslagen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ürünle başla. Paket boyutu ve mağaza fiyatla birlikte kaydedilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai dengan satu produk. Ukuran kemasan dan tokonya dicatat bersama harga."
          }
        }
      }
