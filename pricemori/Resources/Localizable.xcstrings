    "Offers are separated by eligibility and minimum quantity. Regular prices stay in their own comparison." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angebote werden nach Berechtigung und Mindestmenge getrennt. Reguläre Preise bleiben in ihrem eigenen Vergleich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ofertas se separan por elegibilidad y cantidad mínima. Los precios normales mantienen su propia comparación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les offres sont séparées selon l’éligibilité et la quantité minimale. Les prix normaux restent dans leur propre comparaison."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առաջարկները բաժանվում են ըստ իրավունքի և նվազագույն քանակի։ Սովորական գները պահվում են իրենց համեմատության մեջ։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penawaran dipisahkan berdasarkan kelayakan dan jumlah minimum. Harga normal tetap dalam perbandingannya sendiri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le offerte sono separate per idoneità e quantità minima. I prezzi normali restano nel loro confronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特典は適用条件と最小数量で分けられます。通常価格は別々に比較されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "혜택은 이용 조건과 최소 수량으로 구분됩니다. 정상가는 별도로 비교됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanbiedingen worden gescheiden op basis van geschiktheid en minimale hoeveelheid. Normale prijzen blijven in hun eigen vergelijking."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oferty są rozdzielane według uprawnień i minimalnej ilości. Ceny regularne mają własne porównanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofertas são separadas por elegibilidade e quantidade mínima. Preços regulares ficam em sua própria comparação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предложения разделяются по условиям доступа и минимальному количеству. Обычные цены сравниваются отдельно."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teklifler uygunluk ve minimum miktara göre ayrılır. Normal fiyatlar kendi karşılaştırmalarında kalır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропозиції розділяються за умовами доступу та мінімальною кількістю. Звичайні ціни порівнюються окремо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ưu đãi được tách theo điều kiện áp dụng và số lượng tối thiểu. Giá thường so sánh riêng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "优惠按适用条件和起购数量区分。常规价格单独比较。"
          }
        }
      }
    },
