    "This price will be labeled “Card required”. It will not replace the regular-price comparison.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Preis wird als „Karte erforderlich“ gekennzeichnet. Er ersetzt nicht den Vergleich der regulären Preise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce prix sera étiqueté « Carte requise ». Il ne remplacera pas la comparaison des prix normaux."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este precio se etiquetará como «Tarjeta requerida». No sustituirá la comparación de precios normales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
