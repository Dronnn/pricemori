          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지 용량은 그대로입니다. 단위 가격은 패키지 가격에 따라 변합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包装规格未变。单位价格随包装价格变化。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dung tích gói không đổi. Giá đơn vị thay đổi theo giá gói."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il formato della confezione è rimasto invariato. I prezzi unitari variano con il prezzo della confezione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De verpakkingsgrootte is gelijk gebleven. Eenheidsprijzen bewegen mee met de verpakkingsprijs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket boyutu aynı kaldı. Birim fiyatlar paket fiyatıyla birlikte değişir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukuran kemasan tetap sama. Harga satuan bergerak mengikuti harga kemasan."
          }
        }
      }
    },
    "The previous journal is preserved in your exported safety backup. Original record dates and units were kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das vorherige Journal ist in deinem exportierten Sicherheitsbackup erhalten. Die ursprünglichen Erfassungsdaten und Einheiten wurden behalten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal précédent est conservé dans votre sauvegarde de sécurité exportée. Les dates et unités d’origine des enregistrements ont été conservées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario anterior se conserva en tu copia de seguridad exportada. Se mantuvieron las fechas y unidades originales de los registros."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O diário anterior é preservado no seu backup de segurança exportado. As datas e unidades originais dos registros foram mantidas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedni dziennik jest zachowany w wyeksportowanej kopii bezpieczeństwa. Oryginalne daty wpisów i jednostki zostały zachowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прежний журнал сохранён в экспортированной страховочной копии. Исходные даты записей и единицы сохранены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній журнал збережено в експортованій страхувальній копії. Оригінальні дати записів і одиниці збережено."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Նախորդ օրագիրը պահպանվում է ձեր արտահանված անվտանգության պատճենում։ Գրառումների սկզբնական ամսաթվերը և միավորները պահվել են։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のジャーナルは書き出した安全バックアップに保存されています。記録の元の日付と単位は保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 저널은 내보낸 안전 백업에 보관되어 있습니다. 기록의 원래 날짜와 단위는 유지되었습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的记录保存在你导出的安全备份中。原始记录日期和单位已保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhật ký trước đó được giữ trong bản sao lưu an toàn bạn đã xuất. Ngày và đơn vị gốc của bản ghi được giữ nguyên."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Diario precedente è conservato nel backup di sicurezza esportato. Date e unità originali dei record sono state mantenute."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het vorige dagboek blijft bewaard in je geëxporteerde veiligheidsback-up. Oorspronkelijke recorddatums en eenheden zijn behouden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki günlük, dışa aktarılan güvenlik yedeğinde korunuyor. Özgün kayıt tarihleri ve birimleri korundu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jurnal sebelumnya dipertahankan dalam cadangan pengaman yang diekspor. Tanggal dan satuan catatan asli tetap disimpan."
          }
        }
      }
    },
    "The selected backup becomes the entire journal. Changes made after that backup will only remain in your safety copy.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Backup wird zum gesamten Journal. Änderungen nach diesem Backup bleiben nur in deiner Sicherheitskopie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde sélectionnée devient l’intégralité du journal. Les modifications effectuées après cette sauvegarde ne resteront que dans votre copie de sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia seleccionada pasa a ser todo el diario. Los cambios posteriores a esa copia solo permanecerán en tu copia de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup selecionado se torna o diário inteiro. Alterações feitas depois desse backup permanecerão apenas na sua cópia de segurança."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrana kopia stanie się całym dziennikiem. Zmiany wprowadzone po tej kopii pozostaną tylko w kopii bezpieczeństwa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранная копия станет всем журналом. Изменения после этой копии останутся только в страховочной копии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрана копія стане всім журналом. Зміни після цієї копії залишаться лише у страхувальній копії."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընտրված պատճենը կդառնա ամբողջ օրագիրը։ Այդ պատճենից հետո կատարված փոփոխությունները կմնան միայն ձեր անվտանգության պատճենում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したバックアップがジャーナル全体になります。そのバックアップ以降の変更は安全バックアップにのみ残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 백업이 저널 전체가 됩니다. 그 백업 이후의 변경 사항은 안전 백업에만 남습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选中的备份将成为整个记录。该备份之后所做的更改只会保留在你的安全副本中。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu đã chọn trở thành toàn bộ nhật ký. Các thay đổi sau bản sao lưu đó chỉ còn trong bản sao an toàn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup selezionato diventa l’intero Diario. Le modifiche successive a quel backup resteranno solo nella copia di sicurezza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde back-up wordt het volledige dagboek. Wijzigingen na die back-up blijven alleen in je veiligheidskopie staan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen yedek günlüğün tamamı olur. Bu yedekten sonra yapılan değişiklikler yalnızca güvenlik kopyanda kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan yang dipilih menjadi seluruh jurnal. Perubahan setelah cadangan itu hanya akan tersimpan di salinan pengamanmu."
          }
        }
      }
    },
    "There may not be enough free space, or the chosen destination is unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise ist nicht genug Speicherplatz frei oder das gewählte Ziel ist nicht verfügbar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace libre est peut-être insuffisant ou la destination choisie est indisponible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que no haya suficiente espacio libre o que el destino elegido no esté disponible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode não haver espaço livre suficiente ou o destino escolhido estar indisponível."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może brakować wolnego miejsca lub wybrane miejsce docelowe jest niedostępne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, не хватает свободного места или выбранное место недоступно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливо, бракує вільного місця або вибране місце недоступне."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գուցե բավարար ազատ տարածք չկա, կամ ընտրված վայրն անհասանելի է։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りないか、選択した保存先を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 부족하거나 선택한 위치를 사용할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是可用空间不足，或所选位置不可用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể không đủ dung lượng trống hoặc vị trí đã chọn không khả dụng."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe non esserci spazio libero sufficiente o la destinazione scelta non è disponibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is mogelijk niet genoeg vrije ruimte, of de gekozen bestemming is niet beschikbaar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli boş alan olmayabilir veya seçilen hedef kullanılamıyor olabilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin ruang kosong tidak cukup, atau tujuan yang dipilih tidak tersedia."
          }
        }
      }
    },
    "There may not be enough free space, or the chosen destination is unavailable. Your journal is safe on this device. Replacement stays blocked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möglicherweise ist nicht genug Speicherplatz frei oder das gewählte Ziel ist nicht verfügbar. Dein Journal ist auf diesem Gerät sicher. Das Ersetzen bleibt blockiert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’espace libre est peut-être insuffisant ou la destination choisie est indisponible. Votre journal est en sécurité sur cet appareil. Le remplacement reste bloqué."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que no haya suficiente espacio libre o que el destino elegido no esté disponible. Tu diario está a salvo en este dispositivo. El reemplazo sigue bloqueado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode não haver espaço livre suficiente ou o destino escolhido estar indisponível. Seu diário está seguro neste dispositivo. A substituição continua bloqueada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może brakować wolnego miejsca lub wybrane miejsce docelowe jest niedostępne. Twój dziennik jest bezpieczny na tym urządzeniu. Zastąpienie pozostaje zablokowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, не хватает свободного места или выбранное место недоступно. Ваш журнал в безопасности на этом устройстве. Замена остаётся заблокированной."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можливо, бракує вільного місця або вибране місце недоступне. Ваш журнал у безпеці на цьому пристрої. Заміну заблоковано."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գուցե բավարար ազատ տարածք չկա, կամ ընտրված վայրն անհասանելի է։ Ձեր օրագիրն ապահով է այս սարքում։ Փոխարինումը մնում է արգելափակված։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量が足りないか、選択した保存先を利用できません。ジャーナルはこのデバイスに安全に保存されています。置き換えはブロックされたままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 부족하거나 선택한 위치를 사용할 수 없습니다. 저널은 이 기기에 안전하게 보관되어 있습니다. 교체는 차단된 상태입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是可用空间不足，或所选位置不可用。你的记录在此设备上仍然安全，替换操作保持阻止状态。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể không đủ dung lượng trống hoặc vị trí đã chọn không khả dụng. Nhật ký của bạn vẫn an toàn trên thiết bị này. Việc thay thế vẫn bị chặn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe non esserci spazio libero sufficiente o la destinazione scelta non è disponibile. Il tuo Diario è al sicuro su questo dispositivo. La sostituzione resta bloccata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is mogelijk niet genoeg vrije ruimte, of de gekozen bestemming is niet beschikbaar. Je dagboek is veilig op dit apparaat. Vervanging blijft geblokkeerd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeterli boş alan olmayabilir veya seçilen hedef kullanılamıyor olabilir. Günlüğün bu cihazda güvende. Değiştirme hâlâ engelli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mungkin ruang kosong tidak cukup, atau tujuan yang dipilih tidak tersedia. Jurnalmu aman di perangkat ini. Penggantian tetap diblokir."
          }
        }
      }
    },
    "This CSV is for spreadsheets. Use a full backup to restore products, branches and settings together.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese CSV ist für Tabellenkalkulationen. Verwende ein vollständiges Backup, um Produkte, Filialen und Einstellungen gemeinsam wiederherzustellen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce CSV est destiné aux tableurs. Utilisez une sauvegarde complète pour restaurer ensemble les produits, les succursales et les réglages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este CSV es para hojas de cálculo. Usa una copia completa para restaurar productos, sucursales y ajustes juntos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este CSV é para planilhas. Use um backup completo para restaurar produtos, filiais e ajustes juntos."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten CSV jest przeznaczony do arkuszy. Użyj pełnej kopii, aby przywrócić razem produkty, oddziały i ustawienia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот CSV — для таблиц. Используйте полную копию, чтобы восстановить товары, филиалы и настройки вместе."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей CSV — для таблиць. Використайте повну копію, щоб відновити товари, відділення й налаштування разом."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Այս CSV-ն աղյուսակների համար է։ Օգտագործեք ամբողջական պատճեն՝ ապրանքները, մասնաճյուղերը և կարգավորումները միասին վերականգնելու համար։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このCSVは表計算ソフト用です。商品、店舗、設定をまとめて復元するには完全バックアップを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 CSV는 스프레드시트용입니다. 제품, 지점 및 설정을 함께 복원하려면 전체 백업을 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 CSV 用于电子表格。要同时恢复商品、门店和设置，请使用完整备份。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV này dành cho bảng tính. Dùng bản sao lưu đầy đủ để phục hồi sản phẩm, chi nhánh và cài đặt cùng lúc."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo CSV è per i fogli di calcolo. Usa un backup completo per ripristinare insieme prodotti, filiali e impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze CSV is voor spreadsheets. Gebruik een volledige back-up om producten, vestigingen en instellingen samen te herstellen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu CSV elektronik tablolar içindir. Ürünleri, şubeleri ve ayarları birlikte geri yüklemek için tam yedek kullan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "CSV ini untuk spreadsheet. Gunakan cadangan lengkap untuk memulihkan produk, cabang, dan pengaturan sekaligus."
          }
        }
      }
    },
