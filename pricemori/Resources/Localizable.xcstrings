    "Archived locations are excluded from this picker. Restore one from Stores to use it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Standorte sind in dieser Auswahl nicht enthalten. Stelle einen unter Geschäfte wieder her, um ihn zu verwenden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux archivés sont exclus de ce sélecteur. Restaurez-en un depuis Magasins pour l’utiliser."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ubicaciones archivadas se excluyen de este selector. Restaura una en Tiendas para usarla."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Locais arquivados são excluídos deste seletor. Restaure um em Lojas para usá-lo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowane lokalizacje nie są tu wyświetlane. Przywróć jedną w Sklepach, aby z niej korzystać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивные локации не показываются в этом списке. Восстановите нужную в разделе «Магазины»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Архівні локації не показуються в цьому списку. Відновіть потрібну в розділі «Магазини»."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Արխիվացված վայրերը չեն ցուցադրվում այս ցանկում։ Վերականգնեք դրանցից մեկը «Խանութներ»-ում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブ済みの店舗はこの選択肢に表示されません。使用するには「店舗」から復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 매장은 이 목록에 표시되지 않습니다. 사용하려면 매장에서 복원하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的地点不会出现在此选择器中。请从“门店”中恢复后再使用。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Địa điểm đã lưu trữ không hiện trong danh sách này. Hãy khôi phục từ Cửa hàng để sử dụng."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I luoghi archiviati sono esclusi da questo selettore. Ripristinane uno da Negozi per usarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gearchiveerde locaties zijn uitgesloten van deze kiezer. Herstel er een via Winkels om deze te gebruiken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenmiş konumlar bu seçicide gösterilmez. Kullanmak için Mağazalardan birini geri yükle."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi yang diarsipkan tidak disertakan dalam pemilih ini. Pulihkan salah satunya dari Toko untuk menggunakannya."
          }
        }
      }
    },
