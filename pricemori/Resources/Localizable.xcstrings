    "No account, no cloud, no ads. Your journal stays on this device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Cloud, keine Werbung. Dein Journal bleibt auf diesem Gerät."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin cuenta, sin nube, sin anuncios. Tu diario se queda en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans compte, sans cloud, sans publicité. Votre journal reste sur cet appareil."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Առանց հաշվի, առանց ամպի, առանց գովազդի։ Ձեր օրագիրը մնում է այս սարքում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa akun, tanpa cloud, tanpa iklan. Jurnal Anda tetap di perangkat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun account, nessun cloud, nessuna pubblicità. Il tuo diario resta su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントなし、クラウドなし、広告なし。記録はこの端末に残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정도, 클라우드도, 광고도 없습니다. 일지는 이 기기에 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen account, geen cloud, geen advertenties. Je journaal blijft op dit apparaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez konta, bez chmury, bez reklam. Twój dziennik zostaje na tym urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem conta, sem nuvem, sem anúncios. Seu diário fica neste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Без аккаунта, без облака, без рекламы. Ваш дневник остаётся на этом устройстве."
          }
