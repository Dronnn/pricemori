    "Only recorded observations inside the range are plotted. No daily values are generated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nur erfasste Beobachtungen im Zeitraum dargestellt. Es werden keine Tageswerte erzeugt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les observations enregistrées dans la plage sont tracées. Aucune valeur quotidienne n’est générée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se representan las observaciones registradas dentro del intervalo. No se generan valores diarios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas observações registradas dentro do período são exibidas. Nenhum valor diário é gerado."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na wykresie są tylko zapisane obserwacje z zakresu. Wartości dzienne nie są generowane."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На графике только записанные наблюдения из диапазона. Дневные значения не создаются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На графіку лише записані спостереження з діапазону. Денні значення не створюються."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Գրաֆիկում միայն միջակայքի գրանցված դիտարկումներն են։ Օրական արժեքներ չեն ստեղծվում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "範囲内の記録済みの観測記録だけを描画します。日次の値は生成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "범위 안의 기록된 관측 기록만 표시합니다. 일별 값은 생성되지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只绘制范围内的已记录数据。不会生成每日数值。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ vẽ các lần ghi trong khoảng. Không tạo giá trị theo ngày."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono tracciate solo le rilevazioni registrate nell’intervallo. Non vengono generati valori giornalieri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen geregistreerde observaties binnen het bereik worden getoond. Er worden geen dagelijkse waarden gegenereerd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca aralık içindeki kayıtlı gözlemler çizilir. Günlük değerler oluşturulmaz."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya observasi tercatat dalam rentang yang ditampilkan. Tidak ada nilai harian yang dibuat."
          }
        }
      }
    },
