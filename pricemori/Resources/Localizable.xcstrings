    "Charts and price changes will appear when there is enough comparable data." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diagramme und Preisänderungen erscheinen, sobald genug vergleichbare Daten vorliegen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gráficos y los cambios de precio aparecerán cuando haya suficientes datos comparables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les graphiques et les changements de prix apparaîtront lorsqu’il y aura assez de données comparables."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Գրաֆիկները և գնի փոփոխությունները կհայտնվեն, երբ բավարար համեմատելի տվյալներ լինեն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafik dan perubahan harga akan muncul saat data yang dapat dibandingkan cukup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grafici e variazioni di prezzo appariranno quando ci saranno dati confrontabili sufficienti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "比較できるデータが十分になると、グラフと価格の変化が表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
