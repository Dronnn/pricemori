    "How are my prices\nchanging?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie verändern sich\nmeine Preise?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment mes prix\névoluent-ils ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cómo están cambiando\nmis precios?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como meus preços\nestão mudando?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak zmieniają się\nmoje ceny?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как меняются\nмои цены?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Як змінюються\nмої ціни?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչպե՞ս են փոխվում\nիմ գները։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格はどう\n変化している？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격은 어떻게\n변하고 있을까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我的价格如何\n变化？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá của tôi đang\nthay đổi thế nào?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come cambiano\ni miei prezzi?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe veranderen\nmijn prijzen?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiyatlarım nasıl\ndeğişiyor?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana harga saya\nberubah?"
          }
        }
      }
    },
