          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta cena zostanie oznaczona jako „Wymagana karta”. Nie zastąpi porównania cen regularnych."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
