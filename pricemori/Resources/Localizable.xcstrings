    "How do stores differ\nover time?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie unterscheiden sich\nGeschäfte mit der Zeit?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En quoi les magasins\ndiffèrent-ils avec le temps ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué se diferencian\nlas tiendas con el tiempo?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como as lojas diferem\nao longo do tempo?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czym sklepy różnią się\nw czasie?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чем магазины отличаются\nсо временем?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чим магазини різняться\nз часом?"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ինչո՞վ են խանութները տարբերվում\nժամանակի ընթացքում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "店舗ごとに時間とともに\nどう変わる？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매장마다 시간에 따라\n어떻게 다를까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "门店随时间\n有何不同？"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các cửa hàng khác nhau\nthế nào theo thời gian?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come cambiano i negozi\nnel tempo?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe verschillen winkels\nin de loop der tijd?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mağazalar zamanla\nnasıl farklılaşır?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana toko berbeda\nseiring waktu?"
          }
        }
      }
    },
