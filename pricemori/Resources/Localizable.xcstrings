            "value": "Bieżące: produkty %lld / obserwacje %lld\nKopia: produkty %lld / obserwacje %lld"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас: товаров %lld / наблюдений %lld\nКопия: товаров %lld / наблюдений %lld"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз: товарів %lld / спостережень %lld\nКопія: товарів %lld / спостережень %lld"
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ընթացիկ՝ %lld ապրանք / %lld դիտարկում\nՊահուստային՝ %lld ապրանք / %lld դիտարկում"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在: 商品%lld件 / 観測記録%lld件\nバックアップ: 商品%lld件 / 観測記録%lld件"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재: 제품 %lld개 / 관측 기록 %lld개\n백업: 제품 %lld개 / 관측 기록 %lld개"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前：%lld 个商品 / %lld 条记录\n备份：%lld 个商品 / %lld 条记录"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại: %lld sản phẩm / %lld lần ghi\nSao lưu: %lld sản phẩm / %lld lần ghi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attuale: %lld prodotti / %lld rilevazioni\nBackup: %lld prodotti / %lld rilevazioni"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Huidig: %lld producten / %lld observaties\nBack-up: %lld producten / %lld observaties"
