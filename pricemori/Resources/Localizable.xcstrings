    "Expired offers stay in history with their end date. They are not treated as available now." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abgelaufene Angebote bleiben mit ihrem Enddatum im Verlauf. Sie gelten nicht als aktuell verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ofertas caducadas permanecen en el historial con su fecha de fin. No se consideran disponibles ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les offres expirées restent dans l’historique avec leur date de fin. Elles ne sont pas considérées comme disponibles actuellement."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ժամկետանց առաջարկները մնում են պատմության մեջ իրենց ավարտի ամսաթվով։ Դրանք չեն համարվում ներկայում հասանելի։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penawaran kedaluwarsa tetap ada di riwayat dengan tanggal berakhirnya. Penawaran ini tidak dianggap tersedia saat ini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le offerte scadute restano nella cronologia con la loro data di fine. Non vengono considerate disponibili ora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限切れの特典は終了日とともに履歴に残ります。現在利用できる特典としては扱われません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "만료된 혜택은 종료일과 함께 기록에 남습니다. 현재 이용 가능한 혜택으로 처리되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verlopen aanbiedingen blijven met hun einddatum in de geschiedenis staan. Ze gelden nu niet als beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wygasłe oferty pozostają w historii z datą końcową. Nie są traktowane jako obecnie dostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ofertas expiradas ficam no histórico com sua data final. Elas não são tratadas como disponíveis agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истёкшие предложения остаются в истории с датой окончания. Они не считаются доступными сейчас."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Süresi dolmuş teklifler bitiş tarihleriyle geçmişte kalır. Şu anda kullanılabilir sayılmazlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прострочені пропозиції залишаються в історії з датою завершення. Вони не вважаються доступними зараз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ưu đãi hết hạn vẫn ở trong lịch sử kèm ngày kết thúc. Chúng không được coi là hiện có."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已过期优惠会连同结束日期保留在历史记录中，不会被当作当前可用。"
          }
        }
      }
