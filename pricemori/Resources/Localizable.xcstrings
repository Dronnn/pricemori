    "It will be removed from history and charts. You can undo this from History." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Eintrag wird aus Verlauf und Diagrammen entfernt. Du kannst das im Verlauf rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quitará del historial y de los gráficos. Puedes deshacerlo desde el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sera retiré de l’historique et des graphiques. Vous pouvez annuler depuis l’historique."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այն կհեռացվի պատմությունից և գրաֆիկներից։ Կարող եք չեղարկել «Պատմություն»-ում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini akan dihapus dari riwayat dan grafik. Kamu dapat membatalkannya dari Riwayat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verrà rimosso da cronologia e grafici. Puoi annullare l’operazione da Cronologia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴とグラフから削除されます。「履歴」から元に戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록과 차트에서 제거됩니다. 기록에서 되돌릴 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het wordt verwijderd uit de geschiedenis en grafieken. Je kunt dit ongedaan maken via Geschiedenis."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostanie usunięta z historii i wykresów. Możesz to cofnąć w Historii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ele será removido do histórico e dos gráficos. Você pode desfazer isso no histórico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оно исчезнет из истории и графиков. Это можно отменить в разделе «История»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geçmişten ve grafiklerden kaldırılacak. Geçmiş bölümünden geri alabilirsin."
