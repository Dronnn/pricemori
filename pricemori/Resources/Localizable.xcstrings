    "Every feature stays available without a purchase. If the journal is useful, a one-time tip supports its development.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Funktionen bleiben ohne Kauf verfügbar. Wenn dir das Journal hilft, unterstützt ein einmaliges Trinkgeld die Entwicklung."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les fonctions restent disponibles sans achat. Si le journal vous est utile, un pourboire unique soutient son développement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las funciones siguen disponibles sin compra. Si el diario te resulta útil, una propina única apoya su desarrollo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os recursos continuam disponíveis sem compra. Se o diário for útil, uma gorjeta única apoia o desenvolvimento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie funkcje są dostępne bez zakupu. Jeśli dziennik jest przydatny, jednorazowy napiwek wspiera jego rozwój."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все функции доступны без покупки. Если журнал полезен, разовый донат поддержит разработку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усі функції доступні без покупки. Якщо журнал корисний, разовий донат підтримає розробку."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Բոլոր գործառույթները հասանելի են առանց գնման։ Եթե օրագիրը օգտակար է, մեկանգամյա նվիրատվությունը կաջակցի դրա զարգացմանը։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入しなくてもすべての機能を利用できます。このジャーナルが役に立つなら、1回限りの投げ銭で開発を支援できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구매하지 않아도 모든 기능을 사용할 수 있습니다. 이 저널이 유용하다면 일회성 후원으로 개발을 도울 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需购买即可使用所有功能。如果这个记录很有用，可以用一次性打赏支持开发。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tính năng vẫn dùng được mà không cần mua. Nếu nhật ký này hữu ích, một khoản ủng hộ một lần sẽ hỗ trợ phát triển."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutte le funzioni restano disponibili senza acquisti. Se il Diario ti è utile, un’offerta una tantum ne sostiene lo sviluppo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle functies blijven beschikbaar zonder aankoop. Als het dagboek nuttig is, ondersteunt een eenmalige donatie de ontwikkeling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm özellikler satın alma olmadan kullanılabilir. Günlük işine yarıyorsa tek seferlik bir bağış geliştirilmesini destekler."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua fitur tetap tersedia tanpa pembelian. Jika jurnal ini berguna, donasi sekali dapat mendukung pengembangannya."
          }
        }
      }
    },
    "Existing data is kept. Original dates, units, branches and offer conditions are preserved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Daten bleiben erhalten. Ursprüngliche Daten, Einheiten, Filialen und Angebotsbedingungen bleiben bewahrt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données existantes sont conservées. Les dates, unités, succursales et conditions d’offre d’origine sont préservées."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos existentes se conservan. Se mantienen las fechas, unidades, sucursales y condiciones de oferta originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados existentes são mantidos. Datas, unidades, filiais e condições de oferta originais são preservadas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istniejące dane są zachowywane. Oryginalne daty, jednostki, oddziały i warunki ofert pozostają bez zmian."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие данные сохраняются. Исходные даты, единицы, филиалы и условия предложений сохраняются."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наявні дані зберігаються. Оригінальні дати, одиниці, відділення й умови пропозицій зберігаються."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առկա տվյալները պահվում են։ Սկզբնական ամսաթվերը, միավորները, մասնաճյուղերը և առաջարկի պայմանները պահպանվում են։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のデータは保持されます。元の日付、単位、店舗、特典の条件は維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 데이터는 유지됩니다. 원래 날짜, 단위, 지점 및 혜택 조건이 보존됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有数据会保留。原始日期、单位、门店和优惠条件都会保留。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu hiện có được giữ. Ngày, đơn vị, chi nhánh và điều kiện ưu đãi ban đầu được bảo toàn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati esistenti vengono mantenuti. Date, unità, filiali e condizioni dell’offerta originali vengono conservate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande gegevens blijven bewaard. Oorspronkelijke datums, eenheden, vestigingen en aanbiedingsvoorwaarden blijven behouden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut veriler korunur. Özgün tarihler, birimler, şubeler ve teklif koşulları korunur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data yang ada tetap disimpan. Tanggal, satuan, cabang, dan syarat penawaran asli dipertahankan."
          }
        }
      }
    },
    "Existing prices keep their currency and source. A different currency never converts a saved amount automatically.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Preise behalten ihre Währung und Quelle. Eine andere Währung rechnet einen gespeicherten Betrag nie automatisch um."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les prix existants conservent leur devise et leur source. Une autre devise ne convertit jamais automatiquement un montant enregistré."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los precios existentes conservan su moneda y su origen. Otra moneda nunca convierte automáticamente un importe guardado."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os preços existentes mantêm sua moeda e origem. Outra moeda nunca converte um valor salvo automaticamente."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istniejące ceny zachowują walutę i źródło. Inna waluta nigdy nie przelicza zapisanej kwoty automatycznie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие цены сохраняют валюту и источник. Другая валюта никогда не пересчитывает сохранённую сумму автоматически."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наявні ціни зберігають валюту й джерело. Інша валюта ніколи не перераховує збережену суму автоматично."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առկա գները պահում են իրենց արժույթը և աղբյուրը։ Այլ արժույթը երբեք ինքնաշխատ չի փոխարկում պահված գումարը։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の価格は通貨と観測元を保持します。保存済みの金額が別の通貨に自動で換算されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 가격은 통화와 출처를 유지합니다. 저장된 금액이 다른 통화로 자동 변환되지는 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有价格保留其货币和来源。已保存的金额绝不会自动换算成其他货币。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá hiện có giữ nguyên tiền tệ và nguồn. Số tiền đã lưu không bao giờ tự động quy đổi sang tiền tệ khác."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prezzi esistenti mantengono valuta e origine. Una valuta diversa non converte mai automaticamente un importo salvato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande prijzen behouden hun valuta en bron. Een andere valuta rekent een bewaard bedrag nooit automatisch om."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut fiyatlar para birimini ve kaynağını korur. Farklı bir para birimi, kaydedilmiş bir tutarı asla otomatik dönüştürmez."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga yang ada tetap menggunakan mata uang dan sumbernya. Mata uang berbeda tidak pernah mengonversi jumlah tersimpan secara otomatis."
          }
        }
      }
    },
    "Existing records were kept. Imported observations retain their original dates, units and conditions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorhandene Einträge wurden behalten. Importierte Beobachtungen behalten ihre ursprünglichen Daten, Einheiten und Bedingungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements existants ont été conservés. Les observations importées gardent leurs dates, unités et conditions d’origine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservaron los registros existentes. Las observaciones importadas mantienen sus fechas, unidades y condiciones originales."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros existentes foram mantidos. As observações importadas mantêm suas datas, unidades e condições originais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istniejące wpisy zachowano. Zaimportowane obserwacje zachowują oryginalne daty, jednostki i warunki."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существующие записи сохранены. Импортированные наблюдения сохраняют исходные даты, единицы и условия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наявні записи збережено. Імпортовані спостереження зберігають оригінальні дати, одиниці й умови."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Առկա գրառումները պահվել են։ Ներմուծված դիտարկումները պահում են իրենց սկզբնական ամսաթվերը, միավորները և պայմանները։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の記録は保持されました。読み込んだ観測記録は元の日付、単位、条件を保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 기록은 유지되었습니다. 가져온 관측 기록은 원래 날짜, 단위 및 조건을 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现有记录已保留。导入的记录保留其原始日期、单位和条件。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản ghi hiện có được giữ. Các lần ghi đã nhập giữ nguyên ngày, đơn vị và điều kiện ban đầu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record esistenti sono stati mantenuti. Le rilevazioni importate conservano date, unità e condizioni originali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestaande records zijn bewaard. Geïmporteerde observaties behouden hun oorspronkelijke datums, eenheden en voorwaarden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kayıtlar korundu. İçe aktarılan gözlemler özgün tarihlerini, birimlerini ve koşullarını korur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan yang ada tetap disimpan. Observasi yang diimpor mempertahankan tanggal, satuan, dan syarat aslinya."
          }
        }
      }
    },
