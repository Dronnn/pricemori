    "Your journal is safe on this device. No observations were removed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Journal ist auf diesem Gerät sicher. Es wurden keine Beobachtungen entfernt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journal est en sécurité sur cet appareil. Aucune observation n’a été supprimée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu diario está a salvo en este dispositivo. No se eliminó ninguna observación."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu diário está seguro neste dispositivo. Nenhuma observação foi removida."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dziennik jest bezpieczny na tym urządzeniu. Nie usunięto żadnych obserwacji."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш журнал в безопасности на этом устройстве. Ни одно наблюдение не удалено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш журнал у безпеці на цьому пристрої. Жодне спостереження не видалено."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ձեր օրագիրն ապահով է այս սարքում։ Ոչ մի դիտարկում չի հեռացվել։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジャーナルはこのデバイスに安全に保存されています。観測記録は削除されていません。"
