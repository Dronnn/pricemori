    "Frequently tracked products stay easy to find. Their prices and histories are the same as in Journal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Häufig verfolgte Produkte bleiben leicht zu finden. Ihre Preise und Verläufe sind dieselben wie im Journal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les produits suivis fréquemment restent faciles à trouver. Leurs prix et historiques sont les mêmes que dans le journal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los productos que sigues con frecuencia siguen siendo fáciles de encontrar. Sus precios e historiales son los mismos que en el diario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Produtos acompanhados com frequência continuam fáceis de encontrar. Seus preços e históricos são os mesmos do diário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Często śledzone produkty są łatwe do znalezienia. Ich ceny i historie są takie same jak w Dzienniku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто отслеживаемые товары легко найти. Их цены и история такие же, как в журнале."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Часто відстежувані товари легко знайти. Їхні ціни та історія такі самі, як у журналі."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Հաճախ հետևվող ապրանքները հեշտ է գտնել։ Դրանց գներն ու պատմությունը նույնն են, ինչ օրագրում։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく記録する商品はすぐに見つかります。価格と履歴はジャーナルと同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 기록하는 제품은 쉽게 찾을 수 있습니다. 가격과 기록은 저널과 같습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经常记录的商品始终容易找到。其价格和历史记录与记录中相同。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sản phẩm thường xuyên theo dõi luôn dễ tìm. Giá và lịch sử của chúng giống như trong Nhật ký."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I prodotti monitorati di frequente restano facili da trovare. I loro prezzi e le cronologie sono gli stessi del Diario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaak gevolgde producten blijven makkelijk te vinden. Hun prijzen en geschiedenissen zijn hetzelfde als in het Dagboek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık takip edilen ürünler kolayca bulunur. Fiyatları ve geçmişleri Günlüktekiyle aynıdır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Produk yang sering dilacak tetap mudah ditemukan. Harga dan riwayatnya sama seperti di Jurnal."
          }
        }
      }
    },
