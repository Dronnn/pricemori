        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저널은 이 iPhone에 저장됩니다. 나중에 접근할 수 있는 곳에 전체 백업을 보관하세요."
          }
        },
        "zh-Hans": {
