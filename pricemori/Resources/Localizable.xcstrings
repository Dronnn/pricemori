    "Keep each branch separate so your price comparisons refer to the right place." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte jede Filiale getrennt, damit sich deine Preisvergleiche auf den richtigen Ort beziehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén cada sucursal separada para que tus comparaciones de precios se refieran al lugar correcto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez chaque succursale séparée pour que vos comparaisons de prix concernent le bon lieu."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Պահեք յուրաքանչյուր մասնաճյուղ առանձին, որպեսզի գների համեմատությունները վերաբերեն ճիշտ վայրին։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simpan setiap cabang secara terpisah agar perbandingan hargamu mengacu ke tempat yang tepat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantieni separata ogni filiale, così i confronti dei prezzi si riferiscono al posto giusto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "店舗ごとに分けて保存すると、価格の比較が正しい場所を参照します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지점을 따로 저장하면 가격 비교가 올바른 위치를 가리킵니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd elke vestiging apart, zodat je prijsvergelijkingen naar de juiste plek verwijzen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzymaj każdy oddział osobno, aby porównania cen dotyczyły właściwego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha cada filial separada para que suas comparações de preço se refiram ao lugar certo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Храните каждый филиал отдельно, чтобы сравнения цен относились к нужному месту."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her şubeyi ayrı tut, böylece fiyat karşılaştırmaların doğru yere işaret etsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зберігайте кожне відділення окремо, щоб порівняння цін стосувалися правильного місця."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ riêng từng chi nhánh để so sánh giá đúng địa điểm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请分别保存每个门店，这样价格比较才会对应正确的地点。"
          }
        }
      }
    },
