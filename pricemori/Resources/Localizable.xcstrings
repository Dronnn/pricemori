    "No exchange rate is applied. Currency must match to rank prices.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird kein Wechselkurs angewendet. Die Währung muss übereinstimmen, um Preise zu vergleichen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun taux de change n’est appliqué. La devise doit correspondre pour classer les prix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se aplica ningún tipo de cambio. La moneda debe coincidir para clasificar los precios."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma taxa de câmbio é aplicada. A moeda precisa ser a mesma para classificar os preços."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurs wymiany nie jest stosowany. Aby uszeregować ceny, waluta musi się zgadzać."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс обмена не применяется. Чтобы сравнивать цены, валюта должна совпадать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курс обміну не застосовується. Щоб упорядкувати ціни, валюта має збігатися."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Փոխարժեք չի կիրառվում։ Գները դասավորելու համար արժույթը պետք է համընկնի։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "為替レートは適用されません。価格を比較するには通貨が一致する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환율은 적용되지 않습니다. 가격을 비교하려면 통화가 같아야 합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不应用汇率。要比较价格，货币必须一致。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không áp dụng tỷ giá. Tiền tệ phải trùng nhau để so sánh giá."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene applicato alcun tasso di cambio. La valuta deve coincidere per classificare i prezzi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt geen wisselkoers toegepast. De valuta moet overeenkomen om prijzen te rangschikken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Döviz kuru uygulanmaz. Fiyatları sıralamak için para birimi aynı olmalıdır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada nilai tukar yang diterapkan. Mata uang harus sama untuk memeringkat harga."
          }
        }
      }
    },
