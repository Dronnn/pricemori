    "The file cannot be safely restored. No changes were made to your journal.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei kann nicht sicher wiederhergestellt werden. Dein Journal wurde nicht geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier ne peut pas être restauré en toute sécurité. Aucune modification n’a été apportée à votre journal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo no se puede restaurar de forma segura. No se ha modificado tu diario."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo não pode ser restaurado com segurança. Nenhuma alteração foi feita no seu diário."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliku nie można bezpiecznie przywrócić. W dzienniku nie wprowadzono zmian."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл нельзя безопасно восстановить. В журнале ничего не изменено."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл не можна безпечно відновити. У журналі нічого не змінено."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը հնարավոր չէ ապահով վերականգնել։ Ձեր օրագրում փոփոխություններ չեն կատարվել։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは安全に復元できません。ジャーナルは変更されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 안전하게 복원할 수 없습니다. 저널은 변경되지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件无法安全恢复。你的记录没有任何更改。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể phục hồi tệp này một cách an toàn. Nhật ký của bạn không thay đổi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non può essere ripristinato in sicurezza. Non è stata apportata alcuna modifica al Diario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand kan niet veilig worden hersteld. Je dagboek is niet gewijzigd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya güvenli şekilde geri yüklenemez. Günlüğünde hiçbir değişiklik yapılmadı."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak dapat dipulihkan dengan aman. Tidak ada perubahan pada jurnalmu."
          }
        }
      }
    },
    "The file is validated before anything changes. Merge is the default; replacement needs a safety copy first.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird geprüft, bevor etwas geändert wird. Zusammenführen ist Standard; Ersetzen erfordert zuerst eine Sicherheitskopie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est validé avant toute modification. La fusion est l’option par défaut ; le remplacement exige d’abord une copie de sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se valida antes de cambiar nada. Fusionar es la opción predeterminada; el reemplazo requiere primero una copia de seguridad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é validado antes de qualquer alteração. Mesclar é o padrão; a substituição exige primeiro uma cópia de segurança."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik jest sprawdzany, zanim cokolwiek się zmieni. Domyślnie scalane; zastąpienie wymaga najpierw kopii bezpieczeństwa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл проверяется до любых изменений. По умолчанию — объединение; для замены сначала нужна страховочная копия."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл перевіряється до будь-яких змін. Типово — об'єднання; для заміни спершу потрібна страхувальна копія."
          }
        },
        "hy": {
          "stringUnit": {
            "state": "translated",
            "value": "Ֆայլը ստուգվում է նախքան որևէ փոփոխություն։ Լռելյայն միավորումն է. փոխարինման համար նախ պետք է անվտանգության պատճեն։"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは変更前に検証されます。既定は統合で、置き換えには先に安全バックアップが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 변경 전에 검증됩니다. 기본은 병합이며, 교체하려면 먼저 안전 백업이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件会在任何更改前接受验证。默认是合并；替换需要先有安全备份。"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp được xác thực trước khi có bất kỳ thay đổi nào. Mặc định là gộp; thay thế cần bản sao lưu an toàn trước."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file viene convalidato prima di qualsiasi modifica. L’unione è l’opzione predefinita; la sostituzione richiede prima una copia di sicurezza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand wordt gevalideerd voordat er iets verandert. Samenvoegen is de standaard; vervanging vereist eerst een veiligheidskopie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya herhangi bir şey değişmeden önce doğrulanır. Varsayılan birleştirmedir; değiştirme önce güvenlik kopyası gerektirir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File divalidasi sebelum ada yang berubah. Penggabungan adalah default; penggantian memerlukan salinan pengaman terlebih dahulu."
          }
        }
      }
    },
